// The excgrid GGA PIECEWISE-kernel skeleton (fresh authorship; BSD-3-Clause).  A piecewise
// kernel is two branch bodies inside if/else, each with its own braces and CSE namespace;
// `cond` must select the branch the definition's first expression binds.
<?  // Appended to the banner only when the source asks for a tier, so a
    // functional shipping order 1 alone carries no claim that it has one.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries1) + Length(asecondDerivativeEntries2))) [
        WriteString("// The functional's SECOND-DERIVATIVE tier is emitted beside the kernel from the" : Nl());
        WriteString("// same two expressions, and carries the same branch: the matrix is one" : Nl());
        WriteString("// functional's, so a request must be answered by the branch the point is in and" : Nl());
        WriteString("// not by either branch alone.  It is the contract's upper triangle, row-major" : Nl());
        WriteString("// over the five components the kernel takes, in identifier order." : Nl());
    ]; ?>// The banner and the kernel.hpp include are emitted by the calling .ey, which
// always precedes this skeleton, so they are not repeated here.

#include <cmath>
#include <limits>

namespace excgrid {

XcKernelValue <? WriteString(fname); ?>(double rhoA,
                                       double rhoB,
                                       double sigmaAa,
                                       double sigmaAb,
                                       double sigmaBb)
{
<? WriteString(ExUnusedParamSilence({{ra, "rhoA"}, {rb, "rhoB"}, {gaa, "sigmaAa"}, {gab, "sigmaAb"}, {gbb, "sigmaBb"}},
                                    {e1, deDra1, deDrb1, deGaa1, deGab1, deGbb1,
                                     e2, deDra2, deDrb2, deGaa2, deGab2, deGbb2},
                                    {aecsl1, adeDracsl1, adeDrbcsl1, adeGaacsl1, adeGabcsl1, adeGbbcsl1,
                                     aecsl2, adeDracsl2, adeDrbcsl2, adeGaacsl2, adeGabcsl2, adeGbbcsl2})); ?>
    constexpr double eps = std::numeric_limits<double>::epsilon();
    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;
    // The same sigma-edge guard constant the straight-line skeleton declares.
    [[maybe_unused]] constexpr double SigmaGuard = 1e-300;

    XcKernelValue result;

    if (rhoA + rhoB < 2. * eps)
    {
        return result;
    }

    if (<? WriteString(ExCppForm(pwCond)); ?>)
    {
<?  ForEach(d, Reverse(aecsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.exc = <? WriteString(ExCppForm(e1)); ?>;

<?  ForEach(d, Reverse(adeDracsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoA = <? WriteString(ExCppForm(deDra1)); ?>;

<?  ForEach(d, Reverse(adeDrbcsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoB = <? WriteString(ExCppForm(deDrb1)); ?>;

<?  ForEach(d, Reverse(adeGaacsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaAa = <? WriteString(ExCppForm(deGaa1)); ?>;

<?  ForEach(d, Reverse(adeGabcsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaAb = <? WriteString(ExCppForm(deGab1)); ?>;

<?  ForEach(d, Reverse(adeGbbcsl1)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaBb = <? WriteString(ExCppForm(deGbb1)); ?>;
    }
    else
    {
<?  ForEach(d, Reverse(aecsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.exc = <? WriteString(ExCppForm(e2)); ?>;

<?  ForEach(d, Reverse(adeDracsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoA = <? WriteString(ExCppForm(deDra2)); ?>;

<?  ForEach(d, Reverse(adeDrbcsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoB = <? WriteString(ExCppForm(deDrb2)); ?>;

<?  ForEach(d, Reverse(adeGaacsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaAa = <? WriteString(ExCppForm(deGaa2)); ?>;

<?  ForEach(d, Reverse(adeGabcsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaAb = <? WriteString(ExCppForm(deGab2)); ?>;

<?  ForEach(d, Reverse(adeGbbcsl2)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vsigmaBb = <? WriteString(ExCppForm(deGbb2)); ?>;
    }

    return result;
}

<?  // Written from inside a guard rather than as literal text because a
    // functional whose second differentiation the codegen gate cannot afford
    // emits order 1 alone: it gets no tier function at all rather than one
    // that would answer zeros.  clang-format normalises what is written here,
    // so only the token sequence has to be right.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries1) + Length(asecondDerivativeEntries2))) [
        WriteString("void " : fname : "SecondDerivatives(double rhoA," : Nl());
        WriteString("                                              double rhoB," : Nl());
        WriteString("                                              double sigmaAa," : Nl());
        WriteString("                                              double sigmaAb," : Nl());
        WriteString("                                              double sigmaBb," : Nl());
        WriteString("                                              PointSecondDerivativeMatrix& matrix)" : Nl());
        WriteString("{" : Nl());
        WriteString(ExUnusedParamSilence({{ra, "rhoA"}, {rb, "rhoB"}, {gaa, "sigmaAa"}, {gab, "sigmaAb"}, {gbb, "sigmaBb"}},
                                          {e1, deDra1, deDrb1, deGaa1, deGab1, deGbb1,
                                           e2, deDra2, deDrb2, deGaa2, deGab2, deGbb2},
                                          {aecsl1, adeDracsl1, adeDrbcsl1, adeGaacsl1, adeGabcsl1, adeGbbcsl1,
                                           aecsl2, adeDracsl2, adeDrbcsl2, adeGaacsl2, adeGabcsl2, adeGbbcsl2}));
        WriteString(Nl());
        WriteString("    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;" : Nl());
        // Declared only when the tier carries the guard.
        If (atierNeedsGuard, WriteString("    [[maybe_unused]] constexpr double SigmaGuard = 1e-300;" : Nl()));
        WriteString(Nl());
        WriteString("    if (rhoA + rhoB < 2. * std::numeric_limits<double>::epsilon())" : Nl());
        WriteString("    {" : Nl());
        WriteString("        return;" : Nl());
        WriteString("    }" : Nl());
        WriteString(Nl());
        WriteString("    if (" : ExCppForm(pwCond) : ")" : Nl());
        WriteString("    {" : Nl());
        ForEach(entry, asecondDerivativeEntries1) [
            ForEach(d, Reverse(entry[5])) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ];
            WriteString("        matrix.upper[" : String(entry[3]) : "] = " : ExCppForm(entry[4]) : ";" : Nl());
            WriteString(Nl());
        ];
        WriteString("    }" : Nl());
        WriteString("    else" : Nl());
        WriteString("    {" : Nl());
        ForEach(entry, asecondDerivativeEntries2) [
            ForEach(d, Reverse(entry[5])) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ];
            WriteString("        matrix.upper[" : String(entry[3]) : "] = " : ExCppForm(entry[4]) : ";" : Nl());
            WriteString(Nl());
        ];
        WriteString("    }" : Nl());
        WriteString("}" : Nl());
        WriteString(Nl());
    ]; ?>
} // namespace excgrid
