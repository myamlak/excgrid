// The excgrid codegen engine: symbolic differentiation + common-subexpression
// elimination + skeleton expansion, fresh-authored for this project.
// An independent implementation's generator is the MECHANISM precedent
// (differentiate, CSE, substitute the spin-edge limit subexpressions,
// PatchLoad a C++ skeleton);
// this engine is deliberately SMALLER: it emits the order-1 tier only - the
// energy density and the first derivatives (vrho_*, vsigma_*) - because plain
// Vxc assembly consumes first derivatives only; the second/third
// derivative tiers are a mechanical extension for the analytic-gradient track.

Use("excgrid_cpp_form.ys");

// Replaces each tagged subexpression (lhs, rhs) pair of a CSE list inside
// the expression - this is what lets the rhoB = 0 limit expressions flow
// into the derivative code instead of the Tiny-guarded edge values.
// (The Function() declaration form: `:=` with pattern arguments is not
// accepted by yacas's -pc mode.)
Function("ExSubstituteTagged", {sl, e})
[
    Local(r);
    r := e;
    ForEach(i, sl) [ r := Subst(i[2], i[1]) r; ];
    r;
];

// --- Cancelling the removable radical in a gradient derivative -------------
//
// The GGA reduced gradients are all proportional to Sqrt(gamma):
//   X'S(rho, gamma) = 1/2 Sqrt(gamma) / (KF rho + Tiny)   and likewise X'X, X'T.
// Differentiating any of them w.r.t. gamma therefore leaves
//   dF/dgamma = (dF/ds) * (ds/dgamma),
// where dF/ds carries one Sqrt(gamma) (the enhancement is even in s, so
// dF/ds vanishes at s = 0 like s does) and ds/dgamma carries 1/Sqrt(gamma).
// Yacas multiplies the two into a single fraction and does NOT cancel the
// shared Sqrt(gamma), so the emitted quotient is 0/0 at gamma == 0 and the
// kernel returns NaN there even though the limit is finite and nonzero.
//
// This is a REMOVABLE singularity, so the repair is the cancellation and not a
// guard: the shared factor is an exact subtree of both products, and dividing
// it out leaves the analytic derivative.  A clamp would put an invented number
// at the corner; a limit branch would leave the indeterminate quotient in the
// emitted code and contradict the skeleton's no-branch design.  Measured
// 2026-09-18: the reduced form's value at gamma = 0 agrees BIT FOR BIT with
// what the shipped expression already returns at gamma = 5e-324, so the
// cancellation defines the one undefined point and invents nothing.
//
// The transform is deliberately non-recursive and applies only at a top-level
// division (optionally behind the sign): that is exactly the exchange shape,
// and a correlation derivative - a sum at the top - is returned unchanged
// rather than rewritten into a form this generator would not have produced.
// Cancelling at nested divisions would need a general algebraic simplifier;
// yacas' Simplify() is one, and it does not terminate on these expressions
// (measured: > 240 s on the pbe exchange derivative), which is why the
// transform is a targeted factor cancellation and not a Simplify() call.

// Is the listify'd node `l` the binary operator node `t`?
Function("ExOpIs", {l, t})
[
    If ((Length(l) = 3), (UnList({l[1], ExU, ExV}) = t), False);
];

// Does the flat factor list `l` contain the factor `x`?
Function("ExHas", {l, x})
[
    Local(hit);
    hit := False;
    ForEach(i, l) [ If ((i = x), hit := True); ];
    hit;
];

// The factors of a product node, flattened out of yacas' binary Times nesting.
Function("ExFlatFactors", {e})
[
    Local(l);
    If (IsAtom(e), {e},
        [
            l := Listify(e);
            If (ExOpIs(l, ExU*ExV), Concat(ExFlatFactors(l[2]), ExFlatFactors(l[3])), {e});
        ]
    );
];

// A binary product of two factors, with the identity folded out so that a
// one-factor list rebuilds as the factor itself.
Function("ExMul", {a, b})
[
    If ((a = 1), b, If ((b = 1), a, UnList({*, a, b})));
];

// A binary product of a factor list (right-nested, never a multi-argument
// Times node - yacas does not normalize those and the printer emits them as a
// function call rather than as an operator expression).
Function("ExFoldProduct", {l})
[
    Local(r);
    r := 1;
    ForEach(i, l) [ r := ExMul(r, i); ];
    r;
];

// Cancel the factors a division's numerator and denominator share.  A node
// that is not a division comes back unchanged, and so does a division that
// shares nothing: rebuilding it when there is nothing to cancel would
// re-associate the product, and floating-point multiplication is not
// associative, so an unnecessary rebuild would move values it had no reason to
// touch.  The guard is what keeps the regeneration set down to the kernels the
// defect actually reaches.
Function("ExCancelSharedFactors", {e})
[
    Local(l, nf, df, kn, kd);
    l := Listify(e);
    If (ExOpIs(l, ExU/ExV),
        [
            nf := ExFlatFactors(l[2]);
            df := ExFlatFactors(l[3]);
            kn := {}; kd := {};
            ForEach(a, nf) [ If (Not ExHas(df, a), Push(kn, a)); ];
            ForEach(b, df) [ If (Not ExHas(nf, b), Push(kd, b)); ];
            If ((Length(kn) = Length(nf)) And (Length(kd) = Length(df)),
                e,
                UnList({/, ExFoldProduct(kn), ExFoldProduct(kd)}));
        ],
        e
    );
];

// The walk itself, written out rather than handed to yacas' Apply().
//
// Apply() is NOT a tree rewriter and must not be used as one here, measured:
// Apply(id, -a/b) returns a/b - the unary minus is dropped - and
// Apply(id, c - d*e) returns id(c, d*e), i.e. the binary operator node is
// replaced by a call to the function.  Either one silently corrupts a
// derivative, and the first one did: an Apply-based version of this function
// emitted vsigmaAa with its sign stripped.
//
// The entry point for a derivative: step over an optional leading sign, then
// cancel at the division beneath it.
//
// DELIBERATELY NOT RECURSIVE, and the recursion was measured rather than
// assumed away (2026-09-18).  A recursive walk that cancels at every division
// in the tree was built, verified correct on the pbe and becke88 shapes, and
// then rejected on a regression it caused:
//
//   * It changed ten generated files against this function's four, and it
//     BROKE `pbe_correlation` and `pw91_correlation`.  Their vsigma came back
//     exactly 4x too large at every sampled sigma (measured: ratio 4.000 at
//     sigma_total 0.001 through 0.1, drifting to 4.16 at 5.0), because the
//     shared radial in those derivatives is not a plain factor of one quotient
//     - it sits inside a chain of temporaries where the numerator and the
//     denominator do not carry it the same number of times, and a syntactic
//     factor cancellation is simply invalid there.  The suite caught it:
//     `KernelTest.GgaFiniteDifference` failed on the correlation kernels while
//     `exc` and both `vrho` channels stayed bit-identical everywhere.
//   * It did not fix what it was added for.  becke88, pw91 and mpw91 still
//     return NaN at an exactly zero sigma, and inspecting the emitted code
//     says why: their second singular site is `asinh(x) / sqrt(sigma)`, i.e.
//     `C111 / (2 * C102)` with `C111 = log(x + sqrt(1 + x^2))`.  The numerator
//     vanishes like `x` but is NOT a product carrying the radical, so there is
//     no common FACTOR to cancel and no cancellation can reach it.  Reaching
//     that shape needs `asinh(x)/x` written as a function of `x^2`, or a limit
//     branch - a different change from this one.
//
// So the recursion bought two broken kernels and one genuinely-fixed shape
// that a non-recursive cancellation does not reach anyway.  It stays out.
Function("ExCancelRadical", {e})
[
    Local(l);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2),
                If ((UnList({l[1], ExU}) = -ExU),
                    UnList({l[1], ExCancelSharedFactors(l[2])}),
                    e),
                ExCancelSharedFactors(e));
        ]
    );
];

// Rebuilds a CSE assignment list for the skeleton: the yacas CSE tags
// (C1, C2, ...) keep their names on both sides - the skeleton declares
// `const double C1 = ...` and the reduced expressions reference C1
// directly (a scheme proven in the reference implementation's generator; a
// rename would have to reach both sides or the emitted code would not compile).
Function("ExAssignments", {sl})
[
    Local(r);
    r := {};
    ForEach(i, sl) [ Push(r, UnList({:=, i[1], i[2]})); ];
    r;
];

// Does any atom of `tags` occur in `e`?  The probe is exact atom matching, so
// the argument sigmaAb never matches sigmaAa or sigmaBb.
Function("ExAtomOccurs", {tag, e}) [
    ExCppForm(Subst(tag, ExUnusedProbe) e, ExCppFormMaxPrec()) != ExCppForm(e, ExCppFormMaxPrec());
];

Function("ExAnyAtomOccurs", {tags, e})
[
    Local(found);
    found := False;
    ForEach(t, tags) [ If (ExAtomOccurs(t, e), found := True); ];
    found;
];

// Does the kernel read this argument?  Checked against the printed expressions
// AND against the emitted declarations, because the argument appears inside the
// CSE assignments rather than in the reduced expressions themselves.
Function("ExParamIsUsed", {sym, exprs, lists})
[
    Local(used);
    used := False;
    ForEach(x, exprs) [ If (ExAtomOccurs(sym, x), used := True); ];
    ForEach(sl, lists) [
        ForEach(d, sl) [ If (ExAtomOccurs(sym, Listify(d)[3]), used := True); ];
    ];
    used;
];

// The silence statements for the arguments a kernel never reads: a
// spin-unpolarised exchange form never touches sigmaAb, and MSVC reports every
// such argument as C4100.  A void cast in the body is the one-line form -
// annotating the parameter itself would reflow the shared signature into one
// parameter per line, which is the larger diff the annotation was meant to avoid.
Function("ExUnusedParamSilence", {params, exprs, lists})
[
    Local(out);
    out := "";
    ForEach(p, params) [
        If (Not ExParamIsUsed(p[1], exprs, lists),
            out := ConcatStrings(out, "    (void)", p[2], ";", Nl()));
    ];
    out;
];

RuleBaseListed("ExKernelGenerate", {fname, e, args});

100 # ExKernelGenerate(fname_IsString, e_IsFunction, {ra_IsAtom, rb_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, tier_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, tier);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      tier_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier);

// The second-derivative tier costs a full symbolic second differentiation of the
// expression per entry, which for the correlation forms is minutes to tens of
// minutes against seconds for the exchange forms.  A source that passes False
// emits the order-1 kernel alone, so a functional whose tier is not affordable
// is still a functional.
//
// A one-element list when there is at least one entry to emit and an empty one
// when there is not, so a skeleton can wrap the whole emission in a single
// ForEach and read the count without iterating.  A functional without a tier
// then gets no function at all rather than one that answers zeros.
Function("ExTierEmissionGuard", {count})
[
    If (count > 0, {True}, {});
];

ExLdaGenerate(fname, e, ra, rb, tier) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression - Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    If (tier, asecondDerivativeEntries := ExSecondDerivativeEntries(e, {ra, rb}, {}));

    // The exact spin-zero limits (the Tiny guard inside the formulas keeps
    // them finite; the explicit limits give the EXACT one-spin edge values).
    leA := WithValue(ra, 0, e);
    If(leA = Undefined, leA := Limit(ra, 0, Right) e);
    leB := WithValue(rb, 0, e);
    If(leB = Undefined, leB := Limit(rb, 0, Right) e);

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;

    {e, ecsl} := CSE(e);
    {leA, leAcsl} := CSE(leA);
    {leB, leBcsl} := CSE(leB);

    // Express each spin derivative through the OTHER spin's zero-limit
    // subexpressions, so the emitted code is exact at the spin edges.
    deDra := ExSubstituteTagged(leBcsl, deDra);
    deDrb := ExSubstituteTagged(leAcsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);

    aecsl := ExAssignments(ecsl);
    aleAcsl := ExAssignments(leAcsl);
    aleBcsl := ExAssignments(leBcsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);

    PatchLoad("excgrid_lda_skeleton.ey");
];

ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression - Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    If (tier,
        asecondDerivativeEntries :=
            ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}));

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // Cancel the removable Sqrt(gamma) the chain rule leaves in both halves of
    // each sigma derivative.  Without this the emitted quotient is 0/0 at
    // gamma == 0 and the kernel returns NaN at an exactly zero gradient, where
    // the derivative has a finite nonzero limit (ExCancelRadical carries the
    // measurement).  Carried out BEFORE the CSE so the factor cancels as the
    // subtree it is, rather than as two temporaries that no longer look equal.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    {e, ecsl} := CSE(e);

    // Express the density derivatives through the energy density's common
    // subexpressions (keeps the emitted code compact).  The Tiny guards keep
    // the spin edges finite - KF(rho)*rho + Tiny and (rho + Tiny)^(4/3) cannot
    // be zero - but they say nothing about the gamma edge: no guard is applied
    // to gamma, and Sqrt(gamma) is exactly zero at gamma == 0.  The gamma edge
    // is handled by the cancellation above, not by a guard.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);

    PatchLoad("excgrid_gga_skeleton.ey");
];

// One branch of a piecewise GGA kernel, built exactly as ExGgaGenerate builds
// the straight-line one: the energy, the five first derivatives, the density
// derivatives expressed through the energy's common subexpressions, and the
// six assignment lists.  Returned as one 12-element list so the caller can
// bind a whole branch at a time under its own names.
ExPiecewiseBranch(e, ra, rb, gaa, gab, gbb) := [
    Local(deDra, deDrb, deGaa, deGab, deGbb);
    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // Same cancellation as the straight-line path, so the two agree.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    {e, ecsl} := CSE(e);
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    {e, ExAssignments(ecsl),
     deDra, ExAssignments(deDracsl),
     deDrb, ExAssignments(deDrbcsl),
     deGaa, ExAssignments(deGaacsl),
     deGab, ExAssignments(deGabcsl),
     deGbb, ExAssignments(deGbbcsl)};
];

// The piecewise GGA entry point.  `cond` selects the FIRST branch when true;
// the two expressions must be the same functional on either side of the
// boundary the condition tests (see excgrid_gga_piecewise_skeleton.ey for the
// contract, and p86_correlation.ey for the only user so far).
// The branch names (1 for the condition-true side, 2 for the else side) are
// what the skeleton's PatchLoad scope reads.
ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh, ra, rb, gaa, gab, gbb, tier) := [
    Local(b1, b2);

    // The second-derivative tier, one entry list per branch, taken from the two
    // expressions while they are still untagged.  Each branch's list is emitted
    // inside its own braces, exactly as the order-1 branches are, so the two
    // branches' CSE tag namespaces stay separate.
    asecondDerivativeEntries1 := {};
    asecondDerivativeEntries2 := {};
    If (tier, asecondDerivativeEntries1 := ExSecondDerivativeEntries(eLow, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}));
    If (tier, asecondDerivativeEntries2 := ExSecondDerivativeEntries(eHigh, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}));

    b1 := ExPiecewiseBranch(eLow, ra, rb, gaa, gab, gbb);
    e1 := b1[1];
    aecsl1 := b1[2];
    deDra1 := b1[3];
    adeDracsl1 := b1[4];
    deDrb1 := b1[5];
    adeDrbcsl1 := b1[6];
    deGaa1 := b1[7];
    adeGaacsl1 := b1[8];
    deGab1 := b1[9];
    adeGabcsl1 := b1[10];
    deGbb1 := b1[11];
    adeGbbcsl1 := b1[12];

    b2 := ExPiecewiseBranch(eHigh, ra, rb, gaa, gab, gbb);
    e2 := b2[1];
    aecsl2 := b2[2];
    deDra2 := b2[3];
    adeDracsl2 := b2[4];
    deDrb2 := b2[5];
    adeDrbcsl2 := b2[6];
    deGaa2 := b2[7];
    adeGaacsl2 := b2[8];
    deGab2 := b2[9];
    adeGabcsl2 := b2[10];
    deGbb2 := b2[11];
    adeGbbcsl2 := b2[12];

    pwCond := cond;

    PatchLoad("excgrid_gga_piecewise_skeleton.ey");
];

// The piecewise entry point the `.ey` calls.  `args` arrives as the atom list
// in the same order ExKernelGenerate takes it, and is unpacked here rather
// than pattern-matched in the formal argument list: yacas 1.8 refuses to
// create a `:=` function whose parameter is a list pattern ("Could not create
// user function", measured), while indexing the bound list works.
ExPiecewiseKernelGenerate(fname, cond, eLow, eHigh, args) := [
    ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh,
                           args[1], args[2], args[3], args[4], args[5], args[6]);
];

// --- The meta-GGA (tau-dependent) tier -------------------------------------
//
// The entry point below takes the same expression in the seven variables a
// meta-GGA reads: the five the GGA tier differentiates in, plus the two
// kinetic-energy densities the contract reserves as identifiers 5 and 6.  It
// emits the order-1 kernel and, beside it, that functional's SECOND-DERIVATIVE
// tier - the materialised upper triangle the contract's matrix view exposes,
// which is what the analytic-gradient track consumes.
//
// The second-derivative tier is generated symbolically for the same reason the
// first is: the chain rule through the reduced-gradient variables is where a
// hand-derived Hessian goes wrong, and the finite-difference gate in the tests
// is only as good as the algebra it checks.

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      ta_IsAtom, tb_IsAtom}) <--
    ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb);

// The contract's upper-triangle index: entry (i, j) with i <= j of an
// `active` by `active` matrix sits at
//     i*active - i*(i-1)/2 + (j-i),
// which is the row offset of i plus the column offset within the row.
Function("ExUpperTriangleIndex", {i, j, active})
[
    i * active - i * (i - 1) / 2 + j - i;
];

// Is the reduced expression a zero that yacas left inside a quotient?
//
// Differentiating a reciprocal whose numerator's derivative vanishes leaves
// `0/(96*(rho + Tiny)*(rho + Tiny)^(5/3)*...)` rather than folding it: zero
// everywhere the kernel is defined, but three powers and a division to compute
// it, and a declaration of the guard it divides by.  Folding it prints the same
// plain zero the printer already emits for a derivative that never had that
// variable to differentiate.
//
// The test is the NUMERATOR'S OWN TEXT: `String` is what the number printer
// emits, so a numerator that renders as the literal zero is one the emitted
// code already divides as `0.` - folding that quotient cannot move a single
// bit of the result, and the denominators here are products of positive powers
// of (rho + Tiny), so none of them is zero where the kernel is defined.
// Written this way rather than as `num = 0` because yacas' differentiation
// leaves the numerator as a residue below the working precision (measured:
// 0./(96*...) whose numerator prints as `0.` and is nevertheless not `= 0`),
// and rather than as a magnitude threshold, which would be a number this
// generator has no business inventing.
//
// The atom guard is not decoration either: Listify(0) is an error in this
// yacas, and an integer zero is exactly what the derivative of an expression
// that never carried the variable comes back as.
Function("ExIsQuotientZero", {e})
[
    Local(l, z);
    z := False;
    If (Not IsAtom(e),
    [
        l := Listify(e);
        If (ExOpIs(l, ExU/ExV),
            If (IsAtom(l[2]),
                z := ((String(l[2]) = "0.") Or (String(l[2]) = "0")),
                z := ExIsQuotientZero(l[2])));
    ]);
    z;
];

// One entry per unordered pair of the input list, in the contract's
// upper-triangle order: {row, column, flat index, expression, CSE assignments}.
// A pair the energy density does not couple comes back as the integer 0 - the
// generator must not print a different spelling of zero for it than the one
// every other kernel prints - and an uncoupled pair contributes no CSE list.
//
// The expressions are differentiated from the ORIGINAL energy density, before
// the order-1 path substitutes the CSE tags into it, because Deriv() cannot
// differentiate a tag.
//
// `radicalVars` names the reduced-gradient variables, and it is what keeps the
// entries that span one finite at an exactly zero gradient.  A reduced gradient
// enters as Sqrt(gamma), and the radical survives inside the enhancement as a
// squared occurrence - `pow(sqrt(gamma) / (2 * kF * rho), 2)` - which no factor
// cancellation can reach.  Differentiating that w.r.t. gamma leaves a quotient
// carrying Sqrt(gamma) in numerator and denominator alike, so each
// differentiation of a radical-carrying variable is followed by the same
// top-level cancellation the order-1 path applies to its own vsigma.  The
// cancellation is applied to the INNER derivative and then to the outer one
// rather than once to the finished entry, because a cancellation reaches only
// the division at the top of the tree: the outer derivative of an uncancelled
// inner quotient buries the shared radical below a sum, where the flat factor
// scan of ExCancelSharedFactors no longer sees it and the entry is NaN at
// gamma == 0.
// The mixed partials commute, so a pair spanning a radical variable and a plain
// one is differentiated w.r.t. the radical variable first; a pair spanning two
// or none is left in its own order.  A pair with no radical variable is
// differentiated exactly as it was before this argument existed, which is what
// leaves a functional without reduced gradients, and the tau tier,
// byte-identical.
// `For` is the C-style four-argument form here (start, predicate, increment,
// body) - yacas 1.8's controlflow.rep defines it that way, and a three-argument
// call reads its middle argument as the predicate, so it silently runs zero
// times rather than complaining.
Function("ExSecondDerivativeEntries", {e, vars, radicalVars})
[
    Local(n, entries, inner, d2, reduced, i, j, swap, first, second);
    n := Length(vars);
    entries := {};
    For(i := 1, i <= n, i++)
    [
        For(j := i, j <= n, j++)
        [
            swap := ExHas(radicalVars, vars[j]) And Not ExHas(radicalVars, vars[i]);
            first := i;
            second := j;
            If (swap, first := j);
            If (swap, second := i);

            inner := Deriv(vars[first]) e;
            If (ExHas(radicalVars, vars[first]), inner := ExCancelRadical(inner));

            d2 := Deriv(vars[second]) inner;
            If (ExHas(radicalVars, vars[second]), d2 := ExCancelRadical(d2));
            If (ExIsQuotientZero(d2), d2 := 0);
            reduced := CSE(d2);
            Push(entries, {i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), reduced[1],
                           ExAssignments(reduced[2])});
        ];
    ];
    entries;
];

ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression.
    asecondDerivativeEntries :=
        ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb, ta, tb}, {});

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;
    deDta := Deriv(ta) e;
    deDtb := Deriv(tb) e;

    // The same removable-radical cancellation the GGA path applies, for the
    // same reason and with the same measurement behind it: the chain rule
    // leaves a Sqrt(gamma) uncancelled against its own reciprocal, and the
    // emitted quotient would be 0/0 at an exactly zero gradient.  The tau
    // derivatives carry no Sqrt(gamma) and are left alone.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    {e, ecsl} := CSE(e);

    // Express the density derivatives through the energy density's common
    // subexpressions, exactly as the GGA path does.  The kinetic-energy
    // derivatives go through the same substitution: they share the
    // reduced-variable subexpressions.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);
    deDta := ExSubstituteTagged(ecsl, deDta);
    deDtb := ExSubstituteTagged(ecsl, deDtb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);
    {deDta, deDtacsl} := CSE(deDta);
    {deDtb, deDtbcsl} := CSE(deDtb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);
    adeDtacsl := ExAssignments(deDtacsl);
    adeDtbcsl := ExAssignments(deDtbcsl);

    PatchLoad("excgrid_meta_gga_skeleton.ey");
];
