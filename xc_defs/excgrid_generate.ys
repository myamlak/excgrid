// The excgrid codegen engine: symbolic differentiation, CSE and skeleton expansion,
// emitting the order-1 kernel and the materialised second-derivative tier.

Use("excgrid_cpp_form.ys");

// Replaces each (lhs, rhs) pair of a CSE list inside the expression: this is how the
// rhoB = 0 limit expressions reach the derivative code.  (`:=` cannot take patterns.)
Function("ExSubstituteTagged", {sl, e})
[
    Local(r);
    r := e;
    ForEach(i, sl) [ r := Subst(i[2], i[1]) r; ];
    r;
];

// --- Cancelling the removable radical in a gradient derivative -------------
// Yacas does not cancel the Sqrt(gamma) that dF/ds and ds/dgamma share, so the emitted
// quotient is 0/0 at gamma == 0; the exact factor cancellation defines that point.

// Is the listify'd node `l` the binary operator node `t`?
Function("ExOpIs", {l, t})
[
    If ((Length(l) = 3), (UnList({l[1], ExU, ExV}) = t), False);
];

// Does the flat factor list `l` contain the factor `x`?
Function("ExHas", {l, x})
[
    Local(hit);
    hit := False;
    ForEach(i, l) [ If ((i = x), hit := True); ];
    hit;
];

// The list `l` without its element `x`, order preserved.
Function("ExWithout", {l, x})
[
    Local(r);
    r := {};
    ForEach(i, l) [ If (Not (i = x), r := Concat(r, {i})); ];
    r;
];

// The factors of a product node, flattened out of yacas' binary Times nesting.
Function("ExFlatFactors", {e})
[
    Local(l);
    If (IsAtom(e), {e},
        [
            l := Listify(e);
            If (ExOpIs(l, ExU*ExV), Concat(ExFlatFactors(l[2]), ExFlatFactors(l[3])), {e});
        ]
    );
];

// A binary product of two factors, with the identity folded out so that a
// one-factor list rebuilds as the factor itself.
Function("ExMul", {a, b})
[
    If ((a = 1), b, If ((b = 1), a, UnList({*, a, b})));
];

// A binary product of a factor list - right-nested, never a multi-argument Times node
// (yacas does not normalize those and the printer emits a function call).
Function("ExFoldProduct", {l})
[
    Local(r);
    r := 1;
    ForEach(i, l) [ r := ExMul(r, i); ];
    r;
];

// Cancel the factors a division's numerator and denominator share; nothing else is
// rebuilt, because re-associating a product would move floating-point values.
Function("ExCancelSharedFactors", {e})
[
    Local(l, nf, df, kn, kd);
    If (IsAtom(e), e,
    [
    l := Listify(e);
    If (ExOpIs(l, ExU/ExV),
        [
            nf := ExFlatFactors(l[2]);
            df := ExFlatFactors(l[3]);
            kn := {}; kd := {};
            ForEach(a, nf) [ If (Not ExHas(df, a), Push(kn, a)); ];
            ForEach(b, df) [ If (Not ExHas(nf, b), Push(kd, b)); ];
            If ((Length(kn) = Length(nf)) And (Length(kd) = Length(df)),
                e,
                UnList({/, ExFoldProduct(kn), ExFoldProduct(kd)}));
        ],
        e
    );
    ]);
];

// The entry point for a derivative: step over an optional leading sign, then cancel at
// the division beneath it.  Not recursive (invalid for the correlation shapes); Apply()
// is no substitute - it drops the unary minus of -a/b.
Function("ExCancelRadical", {e})
[
    Local(l);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2),
                If ((UnList({l[1], ExU}) = -ExU),
                    UnList({l[1], ExCancelSharedFactors(l[2])}),
                    e),
                ExCancelSharedFactors(e));
        ]
    );
];

// --- Cancelling a radical buried inside a numerator sum ---------------------
// The PBEsol exchange's rational mu leaves a Sqrt(4 sigmaAa) quotient inside a numerator
// sum, out of reach of the top-level cancellation.  TierCancelSum only.
Function("ExCancelSumQuotients", {e})
[
    Local(l, args, i, num, out);
    out := e;
    If (Not IsAtom(e),
        [
            l := Listify(e);
            If (ExOpIs(l, ExU / ExV),
                [
                    num := ExCancelSumQuotients(l[2]);
                    out := ExCancelSharedFactors(UnList({/, num, l[3]}));
                ],
                If (ExOpIs(l, ExU + ExV) Or ExOpIs(l, ExU - ExV) Or ExOpIs(l, ExU * ExV)
                    Or ((Length(l) = 2) And (UnList({l[1], ExU}) = -ExU)),
                    [
                        args := {};
                        For (i := 2, i <= Length(l), i := i + 1)
                            [ args := Concat(args, {ExCancelSumQuotients(l[i])}); ];
                        out := UnList(Concat({l[1]}, args));
                    ]
                )
            );
        ]
    );
    out;
];

// --- Cancelling the removable density power in a density derivative --------
// The chain rule leaves rho * (k rho)^(-2/3), 0 * inf at rho = 0; the identity
// rho * B^(-2/3) = B^(1/3) / (B / rho) makes it analytic.  Density derivatives only.
Function("ExDensityPowerScale", {b, rho, others})
[
    Local(f, i, k, rhoFactors, clean);
    If (IsAtom(b), 0,
        [
            f := ExFlatFactors(b);
            k := 1; rhoFactors := 0; clean := True;
            ForEach(x, f) [
                If ((x = rho),
                    rhoFactors := rhoFactors + 1,
                    If (ExAtomOccurs(rho, x), clean := False, k := k * x));
            ];
            ForEach(o, others) [ If (ExAtomOccurs(o, b), clean := False); ];
            If (clean And (rhoFactors = 1) And Not (k = 0) And (WithValue(rho, 0, b) = 0),
                k, 0);
        ]);
];

// The walk: inside a product, the pair (rho, B^(-2/3)) with B a constant multiple of rho
// becomes B^(1/3) / k.  A node with no such pair comes back unchanged.
Function("ExCancelDensityPower", {e, rho, others})
[
    Local(l, args, out, f, i, b, k, hit, kept, placed);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            args := {};
            For (i := 2, i <= Length(l), i := i + 1)
                [ args := Concat(args, {ExCancelDensityPower(l[i], rho, others)}); ];
            out := UnList(Concat({l[1]}, args));
            If (Not ExOpIs(Listify(out), ExU * ExV), out,
                [
                    f := ExFlatFactors(out);
                    b := 0; k := 0; hit := 0;
                    For (i := 1, i <= Length(f), i := i + 1)
                        [
                            // Listify(4.) is an error, not an empty list: the atom test must
                            // come first.
                            If ((hit = 0) And Not IsAtom(f[i]),
                                [
                                    Local(pf);
                                    pf := Listify(f[i]);
                                    // Tested by VALUE (e*3 + 2 folds to zero): yacas carries
                                    // -2/3 as a division here and as -1 * (2/3) there.
                                    If ((Length(pf) = 3) And (pf[1] = ^) And IsZero(pf[3] * 3. + 2.),
                                        [
                                            Local(scale);
                                            scale := ExDensityPowerScale(pf[2], rho, others);
                                            If (Not IsZero(scale),
                                                [ b := pf[2]; k := scale; hit := i; ]);
                                        ]);
                                ]);
                        ];
                    If (hit = 0, out,
                        [
                            kept := {}; placed := False;
                            For (i := 1, i <= Length(f), i := i + 1)
                                [
                                    If (i != hit,
                                        [
                                            If ((Not placed) And (f[i] = rho),
                                                placed := True,
                                                kept := Concat(kept, {f[i]}));
                                        ]);
                                ];
                            // The rho factor has to be in THIS product: rewriting a
                            // sub-product would multiply the term by rho, not cancel it.
                            If (placed,
                                ExFoldProduct(Concat(kept, {UnList({^, b, 1. / 3.}) / k})),
                                out);
                        ]);
                ]);
        ]);
];

// Shift a density-multiple base of a negative two-thirds power by its scale.
Function("ExGuardDensityPower", {e, rho, others, csl})
[
    Local(l, u, k, args, i);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 3) And (l[1] = ^)
                And IsZero(ExProgramExpand(csl, l[3]) * 3. + 2.),
                [
                    u := ExGuardDensityPower(l[2], rho, others, csl);
                    k := ExDensityPowerScale(ExProgramExpand(csl, u), rho, others);
                    If (IsZero(k), UnList({^, u, l[3]}),
                        UnList({^, u + k * SigmaGuard, l[3]}));
                ],
                [
                    args := {};
                    For (i := 2, i <= Length(l), i := i + 1)
                        [ args := Concat(args, {ExGuardDensityPower(l[i], rho, others, csl)}); ];
                    UnList(Concat({l[1]}, args));
                ]);
        ]);
];

// --- Guarding the sigma-edge radical the cancellation cannot reach ---------
// asinh(x)/Sqrt(sigma) has no common factor.  The radicand is shifted by
// SigmaGuard = 1e-300: below ~1e-284 that is the value, above it the sum rounds back.
Function("ExSigmaRadicalScale", {u, sigma, others})
[
    Local(c, v);
    // Zero every component: the correlation radicand is the total gradient, and only
    // all components together make it vanish.
    v := WithValue(sigma, 0, u);
    ForEach(o, others) [ v := WithValue(o, 0, v); ];
    // Deriv, not Simplify: the radicand is linear in the component, so the derivative
    // IS the scale, and Simplify() renumbers every emitted kernel.
    c := Deriv(sigma) u;
    If (IsNumber(c) And (c > 0) And (v = 0), c, 0);
];

// The same scale over a set of components: the first that applies.
Function("ExSigmaRadicalScaleAny", {u, sigmas})
[
    Local(c, s);
    c := 0;
    ForEach(s, sigmas)
        [ If (IsZero(c), c := ExSigmaRadicalScale(u, s, ExWithout(sigmas, s))); ];
    c;
];

// The walk: replace u by u + c * SigmaGuard inside every radical the guard applies to.
// Every occurrence must carry the shift, or the quotient is a different function.
Function("ExGuardSigmaRadical", {e, sigma, others})
[
    Local(l, u, c, args, i);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2) And (l[1] = Sqrt),
                [
                    u := ExGuardSigmaRadical(l[2], sigma, others);
                    c := ExSigmaRadicalScale(u, sigma, others);
                    If (IsZero(c), UnList({Sqrt, u}), UnList({Sqrt, u + c * SigmaGuard}));
                ],
                [
                    // Concat, not Push: yacas PREPENDS on Push, and UnList would then
                    // apply the last argument as the head.
                    args := {};
                    For (i := 2, i <= Length(l), i := i + 1)
                        [ args := Concat(args, {ExGuardSigmaRadical(l[i], sigma, others)}); ];
                    UnList(Concat({l[1]}, args));
                ]
            );
        ]
    );
];

// Shift every sigma-edge radical of an expression.  The scale is read from the
// radicand expanded through `csl`, so a tag-carried radicand is still measured.
Function("ExGuardSigmaRadicals", {e, sigmas, csl})
[
    Local(l, u, c, args, i);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2) And (l[1] = Sqrt),
                [
                    u := ExGuardSigmaRadicals(l[2], sigmas, csl);
                    c := ExSigmaRadicalScaleAny(ExProgramExpand(csl, l[2]), sigmas);
                    If (IsZero(c), UnList({Sqrt, u}), UnList({Sqrt, u + c * SigmaGuard}));
                ],
                [
                    args := {};
                    For (i := 2, i <= Length(l), i := i + 1)
                        [ args := Concat(args, {ExGuardSigmaRadicals(l[i], sigmas, csl)}); ];
                    UnList(Concat({l[1]}, args));
                ]
            );
        ]
    );
];

// Apply the radical shift to every assignment and the reduced expression.  Every scale
// is measured against the original program, so earlier shifts do not feed back.
Function("ExProgramGuardSigma", {csl, reduced, sigmas})
[
    Local(out, as);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExGuardSigmaRadicals(as[2], sigmas, csl)}}); ];
    {out, ExGuardSigmaRadicals(reduced, sigmas, csl)};
];

// Does the expression carry a square root?
Function("ExHasRadical", {e})
[
    Local(l, hit, x);
    If (IsAtom(e), False,
        [
            l := Listify(e);
            If ((Length(l) = 2) And (l[1] = Sqrt), True,
                [
                    hit := False;
                    ForEach(x, l) [ If (ExHasRadical(x), hit := True); ];
                    hit;
                ]);
        ]);
];

// The square of an expression with every square root reduced to its radicand.
Function("ExSquareWithRadicals", {e})
[
    Local(l);
    If (IsAtom(e), e * e,
        [
            l := Listify(e);
            If ((Length(l) = 2) And (l[1] = Sqrt), l[2],
            If (ExOpIs(l, ExU / ExV),
                ExSquareWithRadicals(l[2]) / ExSquareWithRadicals(l[3]),
            If (ExOpIs(l, ExU * ExV),
                ExSquareWithRadicals(l[2]) * ExSquareWithRadicals(l[3]),
                UnList({^, e, 2}))));
        ]);
];

// Rebuilds a CSE assignment list for the skeleton: the C1, C2, ... tags keep their names
// on both sides, so the declarations and the reduced expressions name the same tag.
Function("ExAssignments", {sl})
[
    Local(r);
    r := {};
    ForEach(i, sl) [ Push(r, UnList({:=, i[1], i[2]})); ];
    r;
];

// Does any atom of `tags` occur in `e`?  Exact atom matching, so sigmaAb never
// matches sigmaAa or sigmaBb.
Function("ExAtomOccurs", {tag, e}) [
    ExCppForm(Subst(tag, ExUnusedProbe) e, ExCppFormMaxPrec()) != ExCppForm(e, ExCppFormMaxPrec());
];

Function("ExAnyAtomOccurs", {tags, e})
[
    Local(found);
    found := False;
    ForEach(t, tags) [ If (ExAtomOccurs(t, e), found := True); ];
    found;
];

// Does the kernel read this argument?  Checked against the printed expressions AND the
// emitted declarations, because the argument appears inside the CSE assignments.
Function("ExParamIsUsed", {sym, exprs, lists})
[
    Local(used);
    used := False;
    ForEach(x, exprs) [ If (ExAtomOccurs(sym, x), used := True); ];
    ForEach(sl, lists) [
        ForEach(d, sl) [ If (ExAtomOccurs(sym, Listify(d)[3]), used := True); ];
    ];
    used;
];

// The silence statements for the arguments a kernel never reads: a spin-unpolarised
// exchange form never touches sigmaAb, which MSVC reports as C4100.  A void cast in the
// body, not an annotation, which would reflow the shared signature.
Function("ExUnusedParamSilence", {params, exprs, lists})
[
    Local(out);
    out := "";
    ForEach(p, params) [
        If (Not ExParamIsUsed(p[1], exprs, lists),
            out := ConcatStrings(out, "    (void)", p[2], ";", Nl()));
    ];
    out;
];

RuleBaseListed("ExKernelGenerate", {fname, e, args});

100 # ExKernelGenerate(fname_IsString, e_IsFunction, {ra_IsAtom, rb_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, tier_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, tier);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      tier_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier);

// TIER MODE, the last list element, default True: False (order 1 only), True (top-level
// cancellation only), TierGuard (radicals shifted first), TierRational (tag powers
// reduced), TierCancelSum (numerator sum quotients cancelled).
// One-element when there is an entry to emit, empty when not.
Function("ExTierEmissionGuard", {count})
[
    If (count > 0, {True}, {});
];

ExLdaGenerateLegacy(fname, e, ra, rb, tier) := [
    // The tier first, while `e` is untagged: Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    If (Not (tier = False), asecondDerivativeEntries := ExSecondDerivativeEntries(e, {ra, rb}, {}, tier));

    // The exact spin-zero limits (the Tiny guard keeps the formulas finite).
    leA := WithValue(ra, 0, e);
    If(leA = Undefined, leA := Limit(ra, 0, Right) e);
    leB := WithValue(rb, 0, e);
    If(leB = Undefined, leB := Limit(rb, 0, Right) e);

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;

    {e, ecsl} := CSE(e);
    {leA, leAcsl} := CSE(leA);
    {leB, leBcsl} := CSE(leB);

    // Each spin derivative goes through the OTHER spin's zero-limit tags.
    deDra := ExSubstituteTagged(leBcsl, deDra);
    deDrb := ExSubstituteTagged(leAcsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);

    aecsl := ExAssignments(ecsl);
    aleAcsl := ExAssignments(leAcsl);
    aleBcsl := ExAssignments(leBcsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);

    PatchLoad("excgrid_lda_skeleton.ey");
];

ExGgaGenerateLegacy(fname, e, ra, rb, gaa, gab, gbb, tier) := [
    // The tier first, while `e` is untagged: Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False),
        asecondDerivativeEntries :=
            ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // The density edge (ExCancelDensityPower), before CSE and on the derivatives only:
    // the energy expression is untouched, which is what keeps the tier where it was.
    deDra := ExCancelDensityPower(deDra, ra, {rb});
    deDrb := ExCancelDensityPower(deDrb, rb, {ra});

    // The removable Sqrt(gamma) in each sigma derivative (ExCancelRadical), before CSE
    // so the factor cancels as the subtree it is.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    // The shape the cancellation cannot reach is answered by shifting the radicand
    // (ExGuardSigmaRadical), also before CSE so the shift reaches every occurrence.
    deGaa := ExGuardSigmaRadical(deGaa, gaa, {gab, gbb});
    deGab := ExGuardSigmaRadical(deGab, gab, {gaa, gbb});
    deGbb := ExGuardSigmaRadical(deGbb, gbb, {gaa, gab});

    {e, ecsl} := CSE(e);

    // The density derivatives go through the energy density's common subexpressions.
    // The Tiny guards keep the spin edges finite; the gamma edge is answered above.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);

    PatchLoad("excgrid_gga_skeleton.ey");
];

// One branch of a piecewise GGA kernel: the energy, the five first derivatives, the
// density derivatives through the energy's subexpressions, and six assignment lists.
ExPiecewiseBranch(e, ra, rb, gaa, gab, gbb) := [
    Local(deDra, deDrb, deGaa, deGab, deGbb);
    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // The same cancellations and sigma-edge guard as the straight-line path.
    deDra := ExCancelDensityPower(deDra, ra, {rb});
    deDrb := ExCancelDensityPower(deDrb, rb, {ra});
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);
    deGaa := ExGuardSigmaRadical(deGaa, gaa, {gab, gbb});
    deGab := ExGuardSigmaRadical(deGab, gab, {gaa, gbb});
    deGbb := ExGuardSigmaRadical(deGbb, gbb, {gaa, gab});

    {e, ecsl} := CSE(e);
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    {e, ExAssignments(ecsl),
     deDra, ExAssignments(deDracsl),
     deDrb, ExAssignments(deDrbcsl),
     deGaa, ExAssignments(deGaacsl),
     deGab, ExAssignments(deGabcsl),
     deGbb, ExAssignments(deGbbcsl)};
];

// The piecewise GGA entry point.  `cond` selects the FIRST branch when true, and must
// test the boundary of the same functional on both sides; branch 1 is the true side.
ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh, ra, rb, gaa, gab, gbb, tier) := [
    Local(b1, b2);

    // One tier entry list per branch, taken while both expressions are still untagged.
    // Each list is emitted inside its own braces, so the tag namespaces stay separate.
    asecondDerivativeEntries1 := {};
    asecondDerivativeEntries2 := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False), asecondDerivativeEntries1 := ExSecondDerivativeEntries(eLow, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));
    If (Not (tier = False), asecondDerivativeEntries2 := ExSecondDerivativeEntries(eHigh, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));

    b1 := ExPiecewiseBranch(eLow, ra, rb, gaa, gab, gbb);
    e1 := b1[1];
    aecsl1 := b1[2];
    deDra1 := b1[3];
    adeDracsl1 := b1[4];
    deDrb1 := b1[5];
    adeDrbcsl1 := b1[6];
    deGaa1 := b1[7];
    adeGaacsl1 := b1[8];
    deGab1 := b1[9];
    adeGabcsl1 := b1[10];
    deGbb1 := b1[11];
    adeGbbcsl1 := b1[12];

    b2 := ExPiecewiseBranch(eHigh, ra, rb, gaa, gab, gbb);
    e2 := b2[1];
    aecsl2 := b2[2];
    deDra2 := b2[3];
    adeDracsl2 := b2[4];
    deDrb2 := b2[5];
    adeDrbcsl2 := b2[6];
    deGaa2 := b2[7];
    adeGaacsl2 := b2[8];
    deGab2 := b2[9];
    adeGabcsl2 := b2[10];
    deGbb2 := b2[11];
    adeGbbcsl2 := b2[12];

    pwCond := cond;

    PatchLoad("excgrid_gga_piecewise_skeleton.ey");
];

// The piecewise entry point the `.ey` calls.  `args` is unpacked here because yacas 1.8
// refuses a `:=` function whose parameter is a list pattern.
ExPiecewiseKernelGenerate(fname, cond, eLow, eHigh, args) := [
    ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh,
                           args[1], args[2], args[3], args[4], args[5], args[6]);
];

// --- The meta-GGA (tau-dependent) tier -------------------------------------
// The seven variables a meta-GGA reads: the five the GGA tier differentiates in, plus
// the two kinetic-energy densities the contract reserves as identifiers 5 and 6.

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      ta_IsAtom, tb_IsAtom}) <--
    ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb);

// The contract's upper-triangle index: entry (i, j), i <= j, of an `active` square matrix
// sits at i*active - i*(i-1)/2 + (j-i).
Function("ExUpperTriangleIndex", {i, j, active})
[
    i * active - i * (i - 1) / 2 + j - i;
];

// Is the reduced expression a zero that yacas left inside a quotient?  Folding it prints
// the plain zero the printer emits elsewhere, and cannot move a bit: the test is the
// numerator's own text, and a numerator rendering as `0.` is already divided as 0.
Function("ExIsQuotientZero", {e})
[
    Local(l, z);
    z := False;
    If (Not IsAtom(e),
    [
        l := Listify(e);
        If (ExOpIs(l, ExU/ExV),
            If (IsAtom(l[2]),
                z := ((String(l[2]) = "0.") Or (String(l[2]) = "0")),
                z := ExIsQuotientZero(l[2])));
    ]);
    z;
];

// One entry per unordered pair, in the contract's upper-triangle order; an uncoupled pair
// is the integer 0.  Differentiated from the ORIGINAL energy density, since Deriv() cannot
// differentiate a tag.
//
// `ahandDerivedEntries` ({variable, variable, expression}) supplies a pair verbatim, with
// no differentiation and none of the repairs; it must carry the kernel's variable atoms.
// `For` is the C-style four-argument form (start, predicate, increment, body): a
// three-argument call reads its middle argument as the predicate and runs zero times.
ahandDerivedEntries := {};

Function("ExHandDerivedEntry", {first, second})
[
    Local(found);
    found := {};
    ForEach(h, ahandDerivedEntries)
        [ If (((h[1] = first) And (h[2] = second))
              Or ((h[1] = second) And (h[2] = first)),
              found := h[3]); ];
    found;
];

Function("ExSecondDerivativeEntriesLegacy", {e, vars, radicalVars, tierMode})
[
    Local(n, entries, inner, d2, reduced, i, j, swap, first, second, sv, hand);
    n := Length(vars);
    entries := {};
    For(i := 1, i <= n, i++)
    [
        For(j := i, j <= n, j++)
        [
            swap := ExHas(radicalVars, vars[j]) And Not ExHas(radicalVars, vars[i]);
            first := i;
            second := j;
            If (swap, first := j);
            If (swap, second := i);

            hand := ExHandDerivedEntry(vars[first], vars[second]);
            If (hand = {},
                [
                    inner := Deriv(vars[first]) e;
                    If (ExHas(radicalVars, vars[first]), inner := ExCancelRadical(inner));

                    // The guard belongs on the FIRST derivative, not the raw second: the
                    // shift is reached before the differentiation duplicates the radical.
                    // Guarding d2 recursed over pbe_correlation and exhausted the stack.
                    If (tierMode = TierGuard,
                        ForEach(sv, radicalVars)
                            [ inner := ExGuardSigmaRadical(inner, sv, ExWithout(radicalVars, sv)); ]);

                    d2 := Deriv(vars[second]) inner;
                    If (ExHas(radicalVars, vars[second]), d2 := ExCancelRadical(d2));

                    // The remaining repair, selected by the source's tier mode.
                    If (tierMode = TierCancelSum, d2 := ExCancelSumQuotients(d2));
                ],
                d2 := hand
            );

            If (ExIsQuotientZero(d2), d2 := 0);
            reduced := CSE(d2);
            Push(entries, {i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), reduced[1],
                           ExAssignments(reduced[2])});
        ];
    ];
    entries;
];

ExMetaGgaGenerateLegacy(fname, e, ra, rb, gaa, gab, gbb, ta, tb) := [
    // The tier first, while `e` is untagged.
    asecondDerivativeEntries :=
        ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb, ta, tb}, {}, True);

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;
    deDta := Deriv(ta) e;
    deDtb := Deriv(tb) e;

    // The same removable-radical cancellation the GGA path applies.  The tau derivatives
    // carry no Sqrt(gamma) and are left alone.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    {e, ecsl} := CSE(e);

    // The density and kinetic-energy derivatives go through the energy density's common
    // subexpressions, exactly as the GGA path does.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);
    deDta := ExSubstituteTagged(ecsl, deDta);
    deDtb := ExSubstituteTagged(ecsl, deDtb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);
    {deDta, deDtacsl} := CSE(deDta);
    {deDtb, deDtbcsl} := CSE(deDtb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);
    adeDtacsl := ExAssignments(deDtacsl);
    adeDtbcsl := ExAssignments(deDtbcsl);

    PatchLoad("excgrid_meta_gga_skeleton.ey");
];

// ---------------------------------------------------------------------------
// Program-level differentiation
//
// A kernel expression is lowered to a let-program of UniqueConstant tags and one reduced
// expression, each right-hand side differentiated once through a tag -> derivative map.

// The atoms of a small expression, without numbers and without repeats.
Function("ExAtomWalk", {e, acc})
[
    If (IsAtom(e),
        If (Not (Or (IsNumber(e), Contains(acc, e))), acc := Concat(acc, {e})),
        ForEach(x, Listify(e)) [ acc := ExAtomWalk(x, acc); ]
    );
    acc;
];

// The total derivative of `e` w.r.t. `v`.  `dmap` maps each tag already differentiated to
// its derivative expression; the walk recurses through arguments (never a list of atoms -
// yacas list storage is not stable across the calls Deriv makes), Deriv() once per tag.
Function("ExTaggedDerivWalk", {node, whole, dmap, seen, d})
[
    Local(n, i, res, c, dd);
    If (IsAtom(node),
        If (Not (IsNumber(node)),
            If (Not Contains(seen, node),
                [
                    seen := Concat(seen, {node});
                    If (Association'Contains(dmap, node),
                        [
                            c := Association'Get(dmap, node);
                            If (Not (c = 0),
                                [
                                    dd := Deriv(node) whole;
                                    d := d + dd * c;
                                ]);
                        ]);
                ])),
        [
            n := NrArgs(node);
            For (i := 1, i <= n, i := i + 1)
                [
                    res := ExTaggedDerivWalk(node[i], whole, dmap, seen, d);
                    seen := res[1];
                    d := res[2];
                ];
        ]
    );
    {seen, d};
];

Function("ExTotalDeriv", {e, v, dmap})
[
    Local(res, d);
    d := Deriv(v) e;
    res := ExTaggedDerivWalk(e, e, dmap, {}, d);
    res[2];
];

// One differentiation pass over a program {reduced, assignments}: returns {derivative,
// its new assignments, the extended assignment list a second pass differentiates}.
Function("ExProgramDeriv", {prog, v})
[
    Local(reduced, csl, dmap, out, d, dt, as, dreduced);
    reduced := prog[1];
    csl := prog[2];
    dmap := Association'Create();
    out := {};
    ForEach(as, csl)
    [
        d := ExTotalDeriv(as[2], v, dmap);
        If (d = 0,
            Association'Set(dmap, as[1], 0),
            [
                dt := UniqueConstant();
                out := Concat(out, {{dt, d}});
                Association'Set(dmap, as[1], dt);
            ]
        );
    ];
    dreduced := ExTotalDeriv(reduced, v, dmap);
    {dreduced, out, Concat(csl, out), dmap};
];

// Node count of an expression, for the scaling record.
Function("ExNodeCount", {e})
[
    Local(n);
    If (IsAtom(e), 1,
        [
            n := 1;
            ForEach(x, Listify(e)) [ n := n + ExNodeCount(x); ];
            n;
        ]
    );
];

// Node count of a whole program: every assignment's right-hand side plus the reduced
// expression.
Function("ExProgramNodes", {csl, reduced})
[
    Local(n);
    n := ExNodeCount(reduced);
    ForEach(as, csl) [ n := n + ExNodeCount(as[2]); ];
    n;
];

// The assignments a reduced expression actually needs, in dependency order.  Evaluating
// the rest could hit an interior singularity that cancels out of the result.
Function("ExProgramNeeded", {csl, reduced})
[
    Local(need, out, as, a);
    need := ExAtomWalk(reduced, {});
    out := {};
    ForEach(as, Reverse(csl))
    [
        If (Contains(need, as[1]),
            [
                out := Concat(out, {as});
                ForEach(a, ExAtomWalk(as[2], {}))
                    [ If (Not Contains(need, a), need := Concat(need, {a})); ];
            ]
        );
    ];
    Reverse(out);
];

// Numeric value of a program at a point: each needed assignment is evaluated to a number
// in dependency order and replaces its tag, without expanding the program.
Function("ExProgramValue", {csl, reduced, vs, xs})
[
    Local(tags, nums, r, v, a, dep, i);
    csl := ExProgramNeeded(csl, reduced);
    tags := {};
    nums := {};
    ForEach(a, csl)
    [
        r := a[2];
        For (i := 1, i <= Length(tags), i := i + 1)
            [ r := WithValue(tags[i], nums[i], r); ];
        r := WithValue(vs, xs, r);
        v := N(Eval(r));
        tags := Concat(tags, {a[1]});
        nums := Concat(nums, {v});
    ];
    r := reduced;
    For (i := 1, i <= Length(tags), i := i + 1)
        [ r := WithValue(tags[i], nums[i], r); ];
    r := WithValue(vs, xs, r);
    N(Eval(r));
];

// Substitute every tag of a program out, in reverse dependency order, so the result is an
// expression in the kernel's inputs.  Used by the self-checks and numeric probes only.
Function("ExProgramExpand", {csl, reduced})
[
    Local(tags, vals, r, as);
    tags := {};
    vals := {};
    ForEach(as, csl)
        [ tags := Concat(tags, {as[1]}); vals := Concat(vals, {as[2]}); ];
    r := reduced;
    // One WithValue call per dependency level, not one per tag: the tags inserted by a
    // call are themselves substituted by the next round.
    While (ExHasAnyAtom(r, tags)) [ r := WithValue(tags, vals, r); ];
    r;
];

Function("ExHasAnyAtom", {e, tags})
[
    Local(hit, x);
    If (IsAtom(e), Contains(tags, e),
        [
            hit := False;
            ForEach(x, Listify(e)) [ If (ExHasAnyAtom(x, tags), hit := True); ];
            hit;
        ]
    );
];
    r;
];

// --- Program-level generator path -------------------------------------------
//
// The order-1 outputs and the second-derivative tier are built by differentiating the
// lowered program, never the expanded tree.

// Is an assignment's right-hand side exactly a square root?
Function("ExIsSqrtRhs", {e})
[
    Local(l);
    If (IsAtom(e), False,
        [
            l := Listify(e);
            (Length(l) = 2) And (l[1] = Sqrt);
        ]
    );
];

// Remove radical tags from a program by substituting their right-hand sides back in: a
// guarded radical has to be reachable by the guard's structural walk, not hidden by a tag.
Function("ExProgramInlineRadicals", {prog})
[
    Local(rads, csl, out, as, rad, r, red);
    csl := prog[2];
    rads := {};
    ForEach(as, csl) [ If (ExIsSqrtRhs(as[2]), rads := Concat(rads, {as})); ];
    out := {};
    ForEach(as, csl)
    [
        If (Not ExIsSqrtRhs(as[2]),
            [
                r := as[2];
                ForEach(rad, Reverse(rads)) [ r := Subst(rad[1], rad[2]) r; ];
                out := Concat(out, {{as[1], r}});
            ]
        );
    ];
    red := prog[1];
    ForEach(rad, Reverse(rads)) [ red := Subst(rad[1], rad[2]) red; ];
    {red, out};
];

// The right-hand side a program gives a tag, or {} when it defines none.
Function("ExProgramTagRhs", {csl, t})
[
    Local(out, as, found);
    out := {};
    found := False;
    ForEach(as, csl)
        [ If (Not found And (as[1] = t), [ out := as[2]; found := True; ]); ];
    out;
];

// Reduce an even power of a tag whose right-hand side carries a square root: the squared
// gradient tag becomes a power of its radicand.
Function("ExReduceTagPowers", {e, csl})
[
    Local(l, u, rhs, r, i, n, args);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 3) And (l[1] = ^) And IsInteger(l[3]) And (l[3] > 0)
                And IsZero(Mod(l[3], 2)),
                [
                    u := ExReduceTagPowers(l[2], csl);
                    rhs := {};
                    If (IsAtom(u), rhs := ExProgramTagRhs(csl, u));
                    If (ExHasRadical(rhs),
                        [
                            r := 1;
                            n := l[3] / 2;
                            For (i := 1, i <= n, i := i + 1)
                                [ r := ExMul(r, ExSquareWithRadicals(rhs)); ];
                            r;
                        ],
                        UnList({^, u, l[3]}));
                ],
                [
                    args := {};
                    For (i := 2, i <= Length(l), i := i + 1)
                        [ args := Concat(args, {ExReduceTagPowers(l[i], csl)}); ];
                    UnList(Concat({l[1]}, args));
                ]);
        ]);
];

// Apply the tag-power reduction to every assignment and the reduced expression.
Function("ExProgramReduceTagPowers", {prog})
[
    Local(csl, out, red, as);
    csl := prog[2];
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExReduceTagPowers(as[2], csl)}}); ];
    red := ExReduceTagPowers(prog[1], csl);
    {red, out};
];

// One repair, selected by an atom rather than by a function argument.
Function("ExProgramRepairExpr", {e, mode, v, rest})
[
    If (mode = DensityPower, ExCancelDensityPower(e, v, rest),
    If (mode = CancelRadical, ExCancelRadical(e),
    If (mode = GuardSigma, ExGuardSigmaRadical(ExCancelRadical(e), v, rest),
    If (mode = CancelSum, ExCancelSumQuotients(e), e))));
];

// Apply a repair to every assignment and the reduced expression.
Function("ExProgramRepair", {csl, reduced, mode, v, rest})
[
    Local(out, as, red);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExProgramRepairExpr(as[2], mode, v, rest)}}); ];
    red := ExProgramRepairExpr(reduced, mode, v, rest);
    {out, red};
];

// The density-base shift over every assignment and the reduced expression.
Function("ExProgramGuardDensity", {csl, reduced, rho, others, res})
[
    Local(out, as);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExGuardDensityPower(as[2], rho, others, res)}}); ];
    {out, ExGuardDensityPower(reduced, rho, others, res)};
];

// Apply the spin-edge limit substitution to every assignment and the reduced expression
// (the LDA path's leA/leB tags).
Function("ExProgramSubstituteTagged", {csl, reduced, sl})
[
    Local(out, as);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExSubstituteTagged(sl, as[2])}}); ];
    {out, ExSubstituteTagged(sl, reduced)};
];

// The assignments of `csl` whose tag is one of the new tags in `newcsl`.
Function("ExKeepNew", {csl, newcsl})
[
    Local(out, as, nn, hit);
    out := {};
    ForEach(as, csl)
    [
        hit := False;
        ForEach(nn, newcsl) [ If (nn[1] = as[1], hit := True); ];
        If (hit, out := Concat(out, {as}));
    ];
    out;
];

// A second differentiation whose chain rule for the ORIGINAL tags comes from an existing
// first-derivative map (`extMap`), so the original tags are not differentiated again.
Function("ExProgramDerivMapped", {csl, reduced, v, extMap})
[
    Local(dmap, out, d, dt, as, dred, p);
    dmap := Association'Create();
    ForEach(p, Association'ToList(extMap)) [ Association'Set(dmap, p[1], p[2]); ];
    out := {};
    ForEach(as, csl)
    [
        d := ExTotalDeriv(as[2], v, dmap);
        If (d = 0,
            Association'Set(dmap, as[1], 0),
            [
                dt := UniqueConstant();
                out := Concat(out, {{dt, d}});
                Association'Set(dmap, as[1], dt);
            ]
        );
    ];
    dred := ExTotalDeriv(reduced, v, dmap);
    {dred, out, Concat(csl, out), dmap};
];

// One order-1 output: differentiate the program, repair the result, prune to the tags the
// answer reads, and keep only the tags this output introduces.
Function("ExFirstDerivOutput", {Pd, v, mode, gv, rest, sl})
[
    Local(r, rep, csl, kept);
    r := ExProgramDeriv(Pd, v);
    rep := ExProgramRepair(r[2], r[1], mode, gv, rest);
    If (mode = DensityPower,
        rep := ExProgramGuardDensity(rep[1], rep[2], gv, rest, Pd[2]));
    csl := ExProgramNeeded(Concat(Pd[2], rep[1]), rep[2]);
    kept := ExKeepNew(csl, rep[1]);
    {rep[2], kept};
];

// The GGA straight-line kernel on the program representation.
ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier) := [
    Local(P, Pd, ecsl, eexpr, r, etier, gp);

    asecondDerivativeEntries := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False),
        [
            etier := e;
            If (tier = TierGuard, etier := ExGuardSigmaRadicals(e, {gaa, gab, gbb}, {}));
            asecondDerivativeEntries :=
                ExSecondDerivativeEntries(etier, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier);
        ]);

    {eexpr, ecsl} := CSE(e);
    gp := ExProgramGuardSigma(ecsl, eexpr, {gaa, gab, gbb});
    ecsl := gp[1]; eexpr := gp[2];
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    r := ExFirstDerivOutput(Pd, ra, DensityPower, ra, {rb}, {});
    deDra := r[1]; adeDracsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, rb, DensityPower, rb, {ra}, {});
    deDrb := r[1]; adeDrbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gaa, GuardSigma, gaa, {gab, gbb}, {});
    deGaa := r[1]; adeGaacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gab, GuardSigma, gab, {gaa, gbb}, {});
    deGab := r[1]; adeGabcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gbb, GuardSigma, gbb, {gaa, gab}, {});
    deGbb := r[1]; adeGbbcsl := ExAssignments(r[2]);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    PatchLoad("excgrid_gga_skeleton.ey");
];

// The second-derivative tier on the program representation: one first-derivative program
// per variable, repaired and guarded once, then the mapped derivative of each row.
Function("ExSecondDerivativeEntries", {e, vars, radicalVars, tierMode})
[
    Local(n, entries, declared, cslP, P, Pd, RD, v, r, i, j, swap, first, second,
          hand, r1, rs, r2, rr, p1out, p1red, p2out, p2red, root, needed, newl,
          as, sv, d2, reduced);
    n := Length(vars);
    {e, cslP} := CSE(e);
    P := {e, cslP};
    Pd := ExProgramInlineRadicals(P);
    If (tierMode = TierRational, Pd := ExProgramReduceTagPowers(Pd));

    RD := Association'Create();
    ForEach(v, vars)
    [
        r := ExProgramDeriv(Pd, v);
        p1out := r[2];
        p1red := r[1];
        If (ExHas(radicalVars, v),
            [
                rr := ExProgramRepair(p1out, p1red, CancelRadical, v, {});
                p1out := rr[1]; p1red := rr[2];
            ]);
        If (tierMode = TierGuard,
            ForEach(sv, radicalVars)
            [
                rr := ExProgramRepair(p1out, p1red, GuardSigma, sv, ExWithout(radicalVars, sv));
                p1out := rr[1]; p1red := rr[2];
            ]);
        Association'Set(RD, v, {p1red, p1out, r[4]});
    ];

    entries := {};
    declared := {};
    For (i := 1, i <= n, i := i + 1)
    [
        For (j := i, j <= n, j := j + 1)
        [
            swap := ExHas(radicalVars, vars[j]) And Not ExHas(radicalVars, vars[i]);
            first := i;
            second := j;
            If (swap, first := j);
            If (swap, second := i);

            hand := ExHandDerivedEntry(vars[first], vars[second]);
            If (hand = {},
                [
                    r1 := Association'Get(RD, vars[first]);
                    rs := Association'Get(RD, vars[second]);
                    r2 := ExProgramDerivMapped(r1[2], r1[1], vars[second], rs[3]);
                    p2out := r2[2];
                    p2red := r2[1];
                    If (ExHas(radicalVars, vars[second]),
                        [
                            rr := ExProgramRepair(p2out, p2red, CancelRadical, vars[second], {});
                            p2out := rr[1]; p2red := rr[2];
                        ]);
                    If (tierMode = TierCancelSum,
                        [
                            rr := ExProgramRepair(p2out, p2red, CancelSum, 0, {});
                            p2out := rr[1]; p2red := rr[2];
                        ]);
                    root := Concat(cslP, r1[2]);
                    If (Not (vars[first] = vars[second]), root := Concat(root, rs[2]));
                    root := Concat(root, p2out);
                    needed := ExProgramNeeded(root, p2red);
                    newl := {};
                    ForEach(as, needed)
                        [ If (Not Contains(declared, as[1]),
                              [ newl := Concat(newl, {as});
                                declared := Concat(declared, {as[1]}); ]); ];
                    If (ExIsQuotientZero(p2red), p2red := 0);
                    entries := Concat(entries,
                        {{i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), p2red,
                          ExAssignments(newl)}});
                ],
                [
                    d2 := hand;
                    If (ExIsQuotientZero(d2), d2 := 0);
                    reduced := CSE(d2);
                    entries := Concat(entries,
                        {{i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), reduced[1],
                          ExAssignments(reduced[2])}});
                ]
            );
        ];
    ];
    entries;
];

// A program's assignments without the tags of another program (the LDA skeleton declares
// its limit tags in the block itself).
Function("ExWithoutTags", {csl, excl})
[
    Local(out, as, ex, hit);
    out := {};
    ForEach(as, csl)
    [
        hit := False;
        ForEach(ex, excl) [ If (ex[1] = as[1], hit := True); ];
        If (Not hit, out := Concat(out, {as}));
    ];
    out;
];

// The LDA straight-line kernel: the two density derivatives, each through the opposite
// spin's exact zero-limit program.  Each skeleton derivative block is its own C++ scope.
ExLdaGenerate(fname, e, ra, rb, tier) := [
    Local(P, Pd, ecsl, eexpr, leA, leB, leAcsl, leBcsl, r, rep, sub, all, kept);

    asecondDerivativeEntries := {};
    atierNeedsGuard := False;
    If (Not (tier = False),
        asecondDerivativeEntries := ExSecondDerivativeEntries(e, {ra, rb}, {}, tier));

    {eexpr, ecsl} := CSE(e);
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    leA := WithValue(ra, 0, e);
    If (leA = Undefined, leA := Limit(ra, 0, Right) e);
    leB := WithValue(rb, 0, e);
    If (leB = Undefined, leB := Limit(rb, 0, Right) e);
    {leA, leAcsl} := CSE(leA);
    {leB, leBcsl} := CSE(leB);

    r := ExProgramDeriv(Pd, ra);
    rep := ExProgramRepair(r[2], r[1], DensityPower, ra, {rb});
    sub := ExProgramSubstituteTagged(rep[1], rep[2], leBcsl);
    all := ExProgramNeeded(Concat(Pd[2], leBcsl, sub[1]), sub[2]);
    kept := ExWithoutTags(all, leBcsl);
    deDra := sub[2];
    adeDracsl := ExAssignments(kept);

    r := ExProgramDeriv(Pd, rb);
    rep := ExProgramRepair(r[2], r[1], DensityPower, rb, {ra});
    sub := ExProgramSubstituteTagged(rep[1], rep[2], leAcsl);
    all := ExProgramNeeded(Concat(Pd[2], leAcsl, sub[1]), sub[2]);
    kept := ExWithoutTags(all, leAcsl);
    deDrb := sub[2];
    adeDrbcsl := ExAssignments(kept);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    aleAcsl := ExAssignments(leAcsl);
    aleBcsl := ExAssignments(leBcsl);
    PatchLoad("excgrid_lda_skeleton.ey");
];

// The meta-GGA straight-line kernel on the program representation.
ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb) := [
    Local(P, Pd, ecsl, eexpr, r);

    asecondDerivativeEntries :=
        ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb, ta, tb}, {}, True);

    {eexpr, ecsl} := CSE(e);
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    r := ExFirstDerivOutput(Pd, ra, DensityPower, ra, {rb}, {});
    deDra := r[1]; adeDracsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, rb, DensityPower, rb, {ra}, {});
    deDrb := r[1]; adeDrbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gaa, CancelRadical, gaa, {}, {});
    deGaa := r[1]; adeGaacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gab, CancelRadical, gab, {}, {});
    deGab := r[1]; adeGabcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gbb, CancelRadical, gbb, {}, {});
    deGbb := r[1]; adeGbbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, ta, None, ta, {}, {});
    deDta := r[1]; adeDtacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, tb, None, tb, {}, {});
    deDtb := r[1]; adeDtbcsl := ExAssignments(r[2]);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    PatchLoad("excgrid_meta_gga_skeleton.ey");
];
