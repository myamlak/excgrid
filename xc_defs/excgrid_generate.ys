// The excgrid codegen engine: symbolic differentiation + common-subexpression
// elimination + skeleton expansion, fresh-authored for this project.
// An independent implementation's generator is the MECHANISM precedent
// (differentiate, CSE, substitute the spin-edge limit subexpressions,
// PatchLoad a C++ skeleton);
// this engine emits the order-1 tier (energy density, vrho_*, vsigma_*)
// beside the materialised second-derivative tier over the same components
// (`ExSecondDerivativeEntries`); a skeleton decides per source which tiers it
// emits, and the tier modes below choose the repair each differentiation
// needs.  There is no third-derivative tier.

Use("excgrid_cpp_form.ys");

// Replaces each tagged subexpression (lhs, rhs) pair of a CSE list inside
// the expression - this is what lets the rhoB = 0 limit expressions flow
// into the derivative code instead of the Tiny-guarded edge values.
// (The Function() declaration form: `:=` with pattern arguments is not
// accepted by yacas's -pc mode.)
Function("ExSubstituteTagged", {sl, e})
[
    Local(r);
    r := e;
    ForEach(i, sl) [ r := Subst(i[2], i[1]) r; ];
    r;
];

// --- Cancelling the removable radical in a gradient derivative -------------
//
// The GGA reduced gradients are all proportional to Sqrt(gamma):
//   X'S(rho, gamma) = 1/2 Sqrt(gamma) / (KF rho + Tiny)   and likewise X'X, X'T.
// Differentiating any of them w.r.t. gamma therefore leaves
//   dF/dgamma = (dF/ds) * (ds/dgamma),
// where dF/ds carries one Sqrt(gamma) (the enhancement is even in s, so
// dF/ds vanishes at s = 0 like s does) and ds/dgamma carries 1/Sqrt(gamma).
// Yacas multiplies the two into a single fraction and does NOT cancel the
// shared Sqrt(gamma), so the emitted quotient is 0/0 at gamma == 0 and the
// kernel returns NaN there even though the limit is finite and nonzero.
//
// This is a REMOVABLE singularity, so the repair is the cancellation and not a
// guard: the shared factor is an exact subtree of both products, and dividing
// it out leaves the analytic derivative.  A clamp would put an invented number
// at the corner; a limit branch would leave the indeterminate quotient in the
// emitted code and contradict the skeleton's no-branch design.  Measured
// 2026-09-18: the reduced form's value at gamma = 0 agrees BIT FOR BIT with
// what the shipped expression already returns at gamma = 5e-324, so the
// cancellation defines the one undefined point and invents nothing.
//
// The transform is deliberately non-recursive and applies only at a top-level
// division (optionally behind the sign): that is exactly the exchange shape,
// and a correlation derivative - a sum at the top - is returned unchanged
// rather than rewritten into a form this generator would not have produced.
// Cancelling at nested divisions would need a general algebraic simplifier;
// yacas' Simplify() is one, and it does not terminate on these expressions
// (measured: > 240 s on the pbe exchange derivative), which is why the
// transform is a targeted factor cancellation and not a Simplify() call.

// Is the listify'd node `l` the binary operator node `t`?
Function("ExOpIs", {l, t})
[
    If ((Length(l) = 3), (UnList({l[1], ExU, ExV}) = t), False);
];

// Does the flat factor list `l` contain the factor `x`?
Function("ExHas", {l, x})
[
    Local(hit);
    hit := False;
    ForEach(i, l) [ If ((i = x), hit := True); ];
    hit;
];

// The list `l` without its element `x`, order preserved.
Function("ExWithout", {l, x})
[
    Local(r);
    r := {};
    ForEach(i, l) [ If (Not (i = x), r := Concat(r, {i})); ];
    r;
];

// The factors of a product node, flattened out of yacas' binary Times nesting.
Function("ExFlatFactors", {e})
[
    Local(l);
    If (IsAtom(e), {e},
        [
            l := Listify(e);
            If (ExOpIs(l, ExU*ExV), Concat(ExFlatFactors(l[2]), ExFlatFactors(l[3])), {e});
        ]
    );
];

// A binary product of two factors, with the identity folded out so that a
// one-factor list rebuilds as the factor itself.
Function("ExMul", {a, b})
[
    If ((a = 1), b, If ((b = 1), a, UnList({*, a, b})));
];

// A binary product of a factor list (right-nested, never a multi-argument
// Times node - yacas does not normalize those and the printer emits them as a
// function call rather than as an operator expression).
Function("ExFoldProduct", {l})
[
    Local(r);
    r := 1;
    ForEach(i, l) [ r := ExMul(r, i); ];
    r;
];

// Cancel the factors a division's numerator and denominator share.  A node
// that is not a division comes back unchanged, and so does a division that
// shares nothing: rebuilding it when there is nothing to cancel would
// re-associate the product, and floating-point multiplication is not
// associative, so an unnecessary rebuild would move values it had no reason to
// touch.  The guard is what keeps the regeneration set down to the kernels the
// defect actually reaches.
Function("ExCancelSharedFactors", {e})
[
    Local(l, nf, df, kn, kd);
    If (IsAtom(e), e,
    [
    l := Listify(e);
    If (ExOpIs(l, ExU/ExV),
        [
            nf := ExFlatFactors(l[2]);
            df := ExFlatFactors(l[3]);
            kn := {}; kd := {};
            ForEach(a, nf) [ If (Not ExHas(df, a), Push(kn, a)); ];
            ForEach(b, df) [ If (Not ExHas(nf, b), Push(kd, b)); ];
            If ((Length(kn) = Length(nf)) And (Length(kd) = Length(df)),
                e,
                UnList({/, ExFoldProduct(kn), ExFoldProduct(kd)}));
        ],
        e
    );
    ]);
];

// The walk itself, written out rather than handed to yacas' Apply().
//
// Apply() is NOT a tree rewriter and must not be used as one here, measured:
// Apply(id, -a/b) returns a/b - the unary minus is dropped - and
// Apply(id, c - d*e) returns id(c, d*e), i.e. the binary operator node is
// replaced by a call to the function.  Either one silently corrupts a
// derivative, and the first one did: an Apply-based version of this function
// emitted vsigmaAa with its sign stripped.
//
// The entry point for a derivative: step over an optional leading sign, then
// cancel at the division beneath it.
//
// DELIBERATELY NOT RECURSIVE, and the recursion was measured rather than
// assumed away (2026-09-18).  A recursive walk that cancels at every division
// in the tree was built, verified correct on the pbe and becke88 shapes, and
// then rejected on a regression it caused:
//
//   * It changed ten generated files against this function's four, and it
//     BROKE `pbe_correlation` and `pw91_correlation`.  Their vsigma came back
//     exactly 4x too large at every sampled sigma (measured: ratio 4.000 at
//     sigma_total 0.001 through 0.1, drifting to 4.16 at 5.0), because the
//     shared radial in those derivatives is not a plain factor of one quotient
//     - it sits inside a chain of temporaries where the numerator and the
//     denominator do not carry it the same number of times, and a syntactic
//     factor cancellation is simply invalid there.  The suite caught it:
//     `KernelTest.GgaFiniteDifference` failed on the correlation kernels while
//     `exc` and both `vrho` channels stayed bit-identical everywhere.
//   * It did not fix what it was added for.  becke88, pw91 and mpw91 still
//     return NaN at an exactly zero sigma, and inspecting the emitted code
//     says why: their second singular site is `asinh(x) / sqrt(sigma)`, i.e.
//     `C111 / (2 * C102)` with `C111 = log(x + sqrt(1 + x^2))`.  The numerator
//     vanishes like `x` but is NOT a product carrying the radical, so there is
//     no common FACTOR to cancel and no cancellation can reach it.  Reaching
//     that shape needs `asinh(x)/x` written as a function of `x^2`, or a limit
//     branch - a different change from this one.
//
// So the recursion bought two broken kernels and one genuinely-fixed shape
// that a non-recursive cancellation does not reach anyway.  It stays out.
// The shape it could not reach - asinh(x)/sqrt(sigma), a numerator that
// vanishes like x without carrying the radical as a factor - is answered by
// ExGuardSigmaRadical below instead, which shifts the radicand rather than
// dividing it out.
Function("ExCancelRadical", {e})
[
    Local(l);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2),
                If ((UnList({l[1], ExU}) = -ExU),
                    UnList({l[1], ExCancelSharedFactors(l[2])}),
                    e),
                ExCancelSharedFactors(e));
        ]
    );
];

// --- Cancelling a radical buried inside a numerator sum ---------------------
//
// The PBEsol exchange carries mu as the rational 10/81 instead of a decimal.
// In its outer sigma-sigma second derivative the quotient rule leaves a
// top-level quotient whose numerator is a SUM, and one summand of that sum is
// itself a quotient carrying Sqrt(4 sigmaAa) in numerator and denominator
// alike.  The top-level cancellation above reaches only the division at the
// top of the tree, so it cannot see that summand: at an exactly zero gradient
// the emitted entry is 0 / 0 (measured: yacas answers Undefined for the
// symbolic derivative at sigmaAa = 0).  The affected entries are the GGA
// matrix's (sigmaAa,sigmaAa) and (sigmaBb,sigmaBb).  The same form with mu as
// a decimal is ONE quotient and cancels at the top, which is why the other
// three PBE-shaped exchanges never showed this.
//
// The repair is the same exact factor cancellation applied one level down:
// walk the numerator through its additive and multiplicative structure and
// cancel at every division found there.  It is NOT the general recursive walk
// rejected above.  It descends only through +, -, unary - and *, and through
// the NUMERATOR of a division - never into a function argument, a power or a
// denominator.  That reaches the quotient-rule shape and leaves every other
// part of the tree, including every correlation derivative, alone.  It runs
// only when a source opts in with the TierCancelSum mode, so no kernel that is
// finite today has its emitted arithmetic rebuilt by it.
//
// The cancellation is an identity wherever the shared factor is nonzero, so
// values away from the edge are unchanged; at the edge it defines the
// removable point.  Measured on the PBEsol outer derivative (rhoA = rhoB = 1,
// sigmaAb = sigmaBb = 0): the repaired expression answers 9.553099947e-6 at
// sigmaAa = 0, 9.553099874e-6 at 1e-6, and agrees to every printed digit with
// the unguarded 9.553027532e-6 at 1e-3 - the finite limit, with the old value
// away from zero.
Function("ExCancelSumQuotients", {e})
[
    Local(l, args, i, num, out);
    out := e;
    If (Not IsAtom(e),
        [
            l := Listify(e);
            If (ExOpIs(l, ExU / ExV),
                [
                    num := ExCancelSumQuotients(l[2]);
                    out := ExCancelSharedFactors(UnList({/, num, l[3]}));
                ],
                If (ExOpIs(l, ExU + ExV) Or ExOpIs(l, ExU - ExV) Or ExOpIs(l, ExU * ExV)
                    Or ((Length(l) = 2) And (UnList({l[1], ExU}) = -ExU)),
                    [
                        args := {};
                        For (i := 2, i <= Length(l), i := i + 1)
                            [ args := Concat(args, {ExCancelSumQuotients(l[i])}); ];
                        out := UnList(Concat({l[1]}, args));
                    ]
                )
            );
        ]
    );
    out;
];

// --- Cancelling the removable density power in a density derivative --------
//
// The exchange rules write their uniform part as the product rho epsX(2 rho),
// i.e. a constant times rho * (3 pi^2 2 rho)^(1/3).  Differentiating that
// product w.r.t. rho leaves one term in which the chain rule's
//   D(rho)[(3 pi^2 2 rho)^(1/3)] = (1/3) (3 pi^2 2 rho)^(-2/3) * 6 pi^2
// is multiplied by the rho the product rule carried out front:
//   rho * (3 pi^2 2 rho)^(-2/3) * 6 pi^2 / 3,
// which is 0 * inf = NaN at rho = 0, where the derivative's exact value is 0
// (the whole thing vanishes like rho^(1/3)).  Measured on the shipped kernels:
// pbe, revpbe, rpbe, pbesol and pw91 answered NaN in vrho of the empty spin
// channel, while becke88, mpw91 and every correlation kernel - which have no
// such product in their uniform part - were finite there.
//
// The singularity is REMOVABLE and the repair is the cancellation, exactly as
// for the radical above: for a base B that is a constant multiple of rho,
//   rho * B^(-2/3) = B^(1/3) / (B / rho),
// an identity in the exponents (rho^1 * rho^(-2/3) = rho^(1/3)), so the
// emitted term is the analytic derivative and is finite at rho = 0.  The
// divisor is the base's own linear coefficient, read off symbolically as B at
// rho = 1.
//
// Applied to the DENSITY derivatives only, and before their CSE: the energy
// expression is left exactly as it was, which is what keeps the emitted
// common subexpressions, every value away from the edge and - measured - the
// second-derivative tier unchanged.  Writing the same function as one power
// in the definitions was tried first and REJECTED on that measurement: it
// left pbe, revpbe and rpbe answering NaN in the tier at an exactly zero
// sigma, where the tier of the product form is finite.  The tier is generated
// from the energy expression, so a repair aimed at the tier has to stay out of
// it.
//
// The scale test is the same shape as the sigma guard's: the base has to be a
// constant multiple of THIS density and of no other (the correlation rules'
// base is the density TOTAL, which is not a channel's own), it has to vanish
// at rho = 0, and its value at rho = 1 has to be a number.  Returns 0 for a
// base the rewrite does not apply to.
// The coefficient is read off STRUCTURALLY - exactly one flat factor of the
// base is this density, and every other factor is free of every density - so
// b = k rho holds by construction and the identity is exact.
//
// It is deliberately not an arithmetic test.  "b - k rho folds to zero" was
// tried first and REJECTED on measurement: yacas does not normalise the factor
// ORDER of a product, so 3 pi^2 2 rho minus 6 pi^2 rho is not zero to IsZero()
// even though it is zero - and every real base the pass has to reach is in the
// unfolded order the chain rule left it in.  (And IsNumber() alone is too
// strict the other way: the exchange rules' coefficient is 6 pi^2, which
// carries the symbolic Pi.)
Function("ExDensityPowerScale", {b, rho, others})
[
    Local(f, i, k, rhoFactors, clean);
    If (IsAtom(b), 0,
        [
            f := ExFlatFactors(b);
            k := 1; rhoFactors := 0; clean := True;
            ForEach(x, f) [
                If ((x = rho),
                    rhoFactors := rhoFactors + 1,
                    If (ExAtomOccurs(rho, x), clean := False, k := k * x));
            ];
            ForEach(o, others) [ If (ExAtomOccurs(o, b), clean := False); ];
            If (clean And (rhoFactors = 1) And Not (k = 0) And (WithValue(rho, 0, b) = 0),
                k, 0);
        ]);
];

// The walk: inside a product, the pair (rho, B^(-2/3)) with B a constant
// multiple of rho becomes B^(1/3) / k.  A node with no such pair comes back
// UNCHANGED - the repo's rule for every one of these passes, because
// rebuilding a product re-associates it and floating-point multiplication is
// not associative.
Function("ExCancelDensityPower", {e, rho, others})
[
    Local(l, args, out, f, i, b, k, hit, kept, placed);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            args := {};
            For (i := 2, i <= Length(l), i := i + 1)
                [ args := Concat(args, {ExCancelDensityPower(l[i], rho, others)}); ];
            out := UnList(Concat({l[1]}, args));
            If (Not ExOpIs(Listify(out), ExU * ExV), out,
                [
                    f := ExFlatFactors(out);
                    b := 0; k := 0; hit := 0;
                    For (i := 1, i <= Length(f), i := i + 1)
                        [
                            // The factors are flattened to atoms and products,
                            // so the Listify() has to be kept behind the atom
                            // test: Listify(4.) is an error, not an empty list.
                            If ((hit = 0) And Not IsAtom(f[i]),
                                [
                                    Local(pf);
                                    pf := Listify(f[i]);
                                    // The exponent is tested by its VALUE (e*3 + 2 folds
                                    // to zero exactly), not by equality: yacas carries
                                    // -2/3 as a division node here and as -1 * (2/3) there,
                                    // and the two printed forms look identical while
                                    // comparing unequal - measured.
                                    If ((Length(pf) = 3) And (pf[1] = ^) And IsZero(pf[3] * 3. + 2.),
                                        [
                                            Local(scale);
                                            scale := ExDensityPowerScale(pf[2], rho, others);
                                            If (Not IsZero(scale),
                                                [ b := pf[2]; k := scale; hit := i; ]);
                                        ]);
                                ]);
                        ];
                    If (hit = 0, out,
                        [
                            kept := {}; placed := False;
                            For (i := 1, i <= Length(f), i := i + 1)
                                [
                                    If (i != hit,
                                        [
                                            If ((Not placed) And (f[i] = rho),
                                                placed := True,
                                                kept := Concat(kept, {f[i]}));
                                        ]);
                                ];
                            // The rho factor has to be IN this product for the
                            // identity to apply: the chain rule leaves the
                            // power inside a sub-product of its own, and
                            // rewriting there (with the rho one level up) would
                            // multiply the term by rho instead of cancelling
                            // it - measured, and the reason this is checked.
                            If (placed,
                                ExFoldProduct(Concat(kept, {UnList({^, b, 1. / 3.}) / k})),
                                out);
                        ]);
                ]);
        ]);
];

// --- Guarding the sigma-edge radical the cancellation cannot reach ---------
//
// Differentiating w.r.t. a sigma component leaves one factor 1 / Sqrt(gamma)
// from the chain rule through the reduced gradient, multiplied by whatever the
// enhancement's s-derivative carries.  Where that derivative vanishes WITH the
// radical the cancellation above divides the shared subtree out and the
// emitted quotient is analytic.  Where it does not - the asinh-carrying
// enhancements of becke88, pw91 and mpw91, whose sigma derivative carries
// asinh(x) / Sqrt(sigma), a numerator that vanishes like x but is not a
// product carrying the radical - there is no factor to divide out and the
// emitted quotient is 0 / 0 at an exactly zero sigma.
//
// The repair is to shift that radicand, in every occurrence, by an amount
// below the last-bit resolution of every sigma above about 1e-284:
//
//   * the quotient is defined at sigma = 0 and answers the LIMIT.  Every
//     occurrence of the radical is shifted, so the emitted value there is the
//     unguarded expression evaluated at sigma = <shift>, which is the limit to
//     ~1e-150 relative - and it is the SAME bits as the value one
//     representable step off zero, the smallest positive subnormal 5e-324
//     absorbing a 1e-300 shift entirely.  That bit-equality is the property
//     the cancelled kernels are pinned by;
//   * nothing else moves.  Above the shift's own scale the sum sigma + shift
//     rounds back to sigma, so the emitted arithmetic is bit-identical to the
//     unguarded one - the shift is chosen so that this holds for every normal
//     sigma, the changed region being sigma below ~1e-284;
//   * the second-derivative tier is deliberately NOT guarded: it is taken from
//     the expression before this pass runs, because the curvature that spans
//     two sigma components is genuinely divergent at sigma = 0 and a shifted
//     radicand would report a large finite number where the truth is
//     infinite.
//
// The radicand the guard applies to: a quantity that is linear in the
// differentiated sigma component with a POSITIVE numeric coefficient, and that
// vanishes when EVERY sigma component is zero.  The original scope was the
// spin channel's own radical (a constant multiple of the component being
// differentiated - 4 sigmaAa and the like).  The correlation forms' radical is
// over the TOTAL gradient (X'T's gamma = sigmaAa + 2 sigmaAb + sigmaBb), whose
// sigma derivative has the same 0 / 0 shape at its own zero; the owner ruling
// of 2026-10-19 put that site inside the guard, because the symbolic
// derivative is finite there.
//
// The two tests decide where the guard applies.  A positive numeric derivative
// means the radicand is c*sigma + v with v free of this component, and
// vanishing at all sigma components zero means the radicand itself meets the
// edge the shift exists for.  The shipped radicands that pass are the channel
// multiples (4 sigmaAa, 4 sigmaBb) and the total gradient (gaa + 2 gab + gbb),
// nonnegative whenever the sigma inputs are; the shift adds a positive
// constant, so it cannot turn one negative.  A radicand carrying a density or
// tau variable fails the numeric-derivative test (rho*sigma, sigma/rho and
// (1 + rho)*sigma all return 0).
//
// The scale is the radicand's own derivative w.r.t. the sigma component, so
// Sqrt(4 sigma) and Sqrt(sigma) shift by 4 and 1, and Sqrt(gamma) by 1 or 2;
// every occurrence of the same radical carries the same shift and the edge
// stays exact.  Returns 0 for a radicand the guard does not apply to (never a
// scale an applicable one could carry: a non-positive derivative is one of the
// exclusions).
Function("ExSigmaRadicalScale", {u, sigma, others})
[
    Local(c, v);
    // Zero every component, not just the differentiated one: the correlation
    // radicand is the total gradient, and only all components together make it
    // vanish.
    v := WithValue(sigma, 0, u);
    ForEach(o, others) [ v := WithValue(o, 0, v); ];
    // Deriv and no Simplify: the radicands this applies to are linear in the
    // component by construction, so the derivative IS the scale, and yacas'
    // Simplify() both allocates CSE tags on every call (measured: ~100 per
    // call, which renumbers every emitted kernel) and is documented above as
    // not terminating on the derivative expressions this generator works with.
    c := Deriv(sigma) u;
    If (IsNumber(c) And (c > 0) And (v = 0), c, 0);
];

// The walk itself: inside every radical the guard applies to, replace the
// radicand u by u + c * SigmaGuard, where c is its scale (above) and
// SigmaGuard is the constant the skeletons declare beside Pi.  Radicals are
// rebuilt rather than left alone because the shift only works if EVERY
// occurrence carries it - a quotient with a shifted numerator over an
// unshifted denominator is a different function at the edge, not the limit.
Function("ExGuardSigmaRadical", {e, sigma, others})
[
    Local(l, u, c, args, i);
    If (IsAtom(e), e,
        [
            l := Listify(e);
            If ((Length(l) = 2) And (l[1] = Sqrt),
                [
                    u := ExGuardSigmaRadical(l[2], sigma, others);
                    c := ExSigmaRadicalScale(u, sigma, others);
                    If (IsZero(c), UnList({Sqrt, u}), UnList({Sqrt, u + c * SigmaGuard}));
                ],
                [
                    // Rebuilt argument by argument.  Concat and not Push: yacas
                    // PREPENDS on Push, so a Push-built argument list comes out
                    // reversed and UnList then applies the last argument as the
                    // head - measured, and the reason this is spelled out.
                    args := {};
                    For (i := 2, i <= Length(l), i := i + 1)
                        [ args := Concat(args, {ExGuardSigmaRadical(l[i], sigma, others)}); ];
                    UnList(Concat({l[1]}, args));
                ]
            );
        ]
    );
];

// Rebuilds a CSE assignment list for the skeleton: the yacas CSE tags
// (C1, C2, ...) keep their names on both sides - the skeleton declares
// `const double C1 = ...` and the reduced expressions reference C1
// directly (a scheme proven in the reference implementation's generator; a
// rename would have to reach both sides or the emitted code would not compile).
Function("ExAssignments", {sl})
[
    Local(r);
    r := {};
    ForEach(i, sl) [ Push(r, UnList({:=, i[1], i[2]})); ];
    r;
];

// Does any atom of `tags` occur in `e`?  The probe is exact atom matching, so
// the argument sigmaAb never matches sigmaAa or sigmaBb.
Function("ExAtomOccurs", {tag, e}) [
    ExCppForm(Subst(tag, ExUnusedProbe) e, ExCppFormMaxPrec()) != ExCppForm(e, ExCppFormMaxPrec());
];

Function("ExAnyAtomOccurs", {tags, e})
[
    Local(found);
    found := False;
    ForEach(t, tags) [ If (ExAtomOccurs(t, e), found := True); ];
    found;
];

// Does the kernel read this argument?  Checked against the printed expressions
// AND against the emitted declarations, because the argument appears inside the
// CSE assignments rather than in the reduced expressions themselves.
Function("ExParamIsUsed", {sym, exprs, lists})
[
    Local(used);
    used := False;
    ForEach(x, exprs) [ If (ExAtomOccurs(sym, x), used := True); ];
    ForEach(sl, lists) [
        ForEach(d, sl) [ If (ExAtomOccurs(sym, Listify(d)[3]), used := True); ];
    ];
    used;
];

// The silence statements for the arguments a kernel never reads: a
// spin-unpolarised exchange form never touches sigmaAb, and MSVC reports every
// such argument as C4100.  A void cast in the body is the one-line form -
// annotating the parameter itself would reflow the shared signature into one
// parameter per line, which is the larger diff the annotation was meant to avoid.
Function("ExUnusedParamSilence", {params, exprs, lists})
[
    Local(out);
    out := "";
    ForEach(p, params) [
        If (Not ExParamIsUsed(p[1], exprs, lists),
            out := ConcatStrings(out, "    (void)", p[2], ";", Nl()));
    ];
    out;
];

RuleBaseListed("ExKernelGenerate", {fname, e, args});

100 # ExKernelGenerate(fname_IsString, e_IsFunction, {ra_IsAtom, rb_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, True);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, tier_IsAtom}) <--
    ExLdaGenerate(fname, e, ra, rb, tier);

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      tier_IsAtom}) <--
    ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier);

// The second-derivative tier costs a full symbolic second differentiation of the
// expression per entry, which for the correlation forms is minutes to tens of
// minutes against seconds for the exchange forms.  The last list element is
// the TIER MODE:
//   False         - order 1 only; the emitted kernel carries no tier function.
//   True          - the tier, with the top-level cancellation only.
//   TierGuard     - the tier, with every applicable radical shifted
//                   (ExGuardSigmaRadical) so the entry is finite at a zero
//                   gradient.  The shift is applied to the FIRST derivative,
//                   before the second differentiation.  The correlation
//                   forms, and becke88/pw91 for their entries other than the
//                   two hand-derived ones.
//   TierCancelSum - the tier, with the numerator sum's nested quotients
//                   cancelled (ExCancelSumQuotients).  PBEsol only.
// The default, when the list has no mode element, is True.
//
// A one-element list when there is at least one entry to emit and an empty one
// when there is not, so a skeleton can wrap the whole emission in a single
// ForEach and read the count without iterating.  A functional without a tier
// then gets no function at all rather than one that answers zeros.
Function("ExTierEmissionGuard", {count})
[
    If (count > 0, {True}, {});
];

ExLdaGenerateLegacy(fname, e, ra, rb, tier) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression - Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    If (Not (tier = False), asecondDerivativeEntries := ExSecondDerivativeEntries(e, {ra, rb}, {}, tier));

    // The exact spin-zero limits (the Tiny guard inside the formulas keeps
    // them finite; the explicit limits give the EXACT one-spin edge values).
    leA := WithValue(ra, 0, e);
    If(leA = Undefined, leA := Limit(ra, 0, Right) e);
    leB := WithValue(rb, 0, e);
    If(leB = Undefined, leB := Limit(rb, 0, Right) e);

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;

    {e, ecsl} := CSE(e);
    {leA, leAcsl} := CSE(leA);
    {leB, leBcsl} := CSE(leB);

    // Express each spin derivative through the OTHER spin's zero-limit
    // subexpressions, so the emitted code is exact at the spin edges.
    deDra := ExSubstituteTagged(leBcsl, deDra);
    deDrb := ExSubstituteTagged(leAcsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);

    aecsl := ExAssignments(ecsl);
    aleAcsl := ExAssignments(leAcsl);
    aleBcsl := ExAssignments(leBcsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);

    PatchLoad("excgrid_lda_skeleton.ey");
];

ExGgaGenerateLegacy(fname, e, ra, rb, gaa, gab, gbb, tier) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression - Deriv() cannot differentiate a CSE tag.
    asecondDerivativeEntries := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False),
        asecondDerivativeEntries :=
            ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // The density edge: the removable rho * (k rho)^(-2/3) the chain rule
    // leaves in each spin-density derivative (ExCancelDensityPower carries the
    // measurement).  Before the CSE, and on the derivatives only - the energy
    // expression is untouched, which is what keeps the tier where it was.
    deDra := ExCancelDensityPower(deDra, ra, {rb});
    deDrb := ExCancelDensityPower(deDrb, rb, {ra});

    // Cancel the removable Sqrt(gamma) the chain rule leaves in both halves of
    // each sigma derivative.  Without this the emitted quotient is 0/0 at
    // gamma == 0 and the kernel returns NaN at an exactly zero gradient, where
    // the derivative has a finite nonzero limit (ExCancelRadical carries the
    // measurement).  Carried out BEFORE the CSE so the factor cancels as the
    // subtree it is, rather than as two temporaries that no longer look equal.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    // The shape the cancellation cannot reach - asinh(x)/sqrt(sigma), whose
    // numerator vanishes like x without carrying the radical - is answered by
    // shifting that radicand instead (ExGuardSigmaRadical carries the
    // measurement).  Also before the CSE, for the same reason: the shift has
    // to reach every occurrence of the radical.
    deGaa := ExGuardSigmaRadical(deGaa, gaa, {gab, gbb});
    deGab := ExGuardSigmaRadical(deGab, gab, {gaa, gbb});
    deGbb := ExGuardSigmaRadical(deGbb, gbb, {gaa, gab});

    {e, ecsl} := CSE(e);

    // Express the density derivatives through the energy density's common
    // subexpressions (keeps the emitted code compact).  The Tiny guards keep
    // the spin edges finite - KF(rho)*rho + Tiny and (rho + Tiny)^(4/3) cannot
    // be zero.  The gamma edge is answered above: by the cancellation where
    // the radical is a factor, and by the radicand shift where it is not;
    // since the owner ruling of 2026-10-19 the shift also covers the
    // correlation forms' total gradient.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);

    PatchLoad("excgrid_gga_skeleton.ey");
];

// One branch of a piecewise GGA kernel, built exactly as ExGgaGenerate builds
// the straight-line one: the energy, the five first derivatives, the density
// derivatives expressed through the energy's common subexpressions, and the
// six assignment lists.  Returned as one 12-element list so the caller can
// bind a whole branch at a time under its own names.
ExPiecewiseBranch(e, ra, rb, gaa, gab, gbb) := [
    Local(deDra, deDrb, deGaa, deGab, deGbb);
    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;

    // Same cancellations and same sigma-edge guard as the straight-line path,
    // so the two agree.
    deDra := ExCancelDensityPower(deDra, ra, {rb});
    deDrb := ExCancelDensityPower(deDrb, rb, {ra});
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);
    deGaa := ExGuardSigmaRadical(deGaa, gaa, {gab, gbb});
    deGab := ExGuardSigmaRadical(deGab, gab, {gaa, gbb});
    deGbb := ExGuardSigmaRadical(deGbb, gbb, {gaa, gab});

    {e, ecsl} := CSE(e);
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);

    {e, ExAssignments(ecsl),
     deDra, ExAssignments(deDracsl),
     deDrb, ExAssignments(deDrbcsl),
     deGaa, ExAssignments(deGaacsl),
     deGab, ExAssignments(deGabcsl),
     deGbb, ExAssignments(deGbbcsl)};
];

// The piecewise GGA entry point.  `cond` selects the FIRST branch when true;
// the two expressions must be the same functional on either side of the
// boundary the condition tests (see excgrid_gga_piecewise_skeleton.ey for the
// contract, and p86_correlation.ey for the only user so far).
// The branch names (1 for the condition-true side, 2 for the else side) are
// what the skeleton's PatchLoad scope reads.
ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh, ra, rb, gaa, gab, gbb, tier) := [
    Local(b1, b2);

    // The second-derivative tier, one entry list per branch, taken from the two
    // expressions while they are still untagged.  Each branch's list is emitted
    // inside its own braces, exactly as the order-1 branches are, so the two
    // branches' CSE tag namespaces stay separate.
    asecondDerivativeEntries1 := {};
    asecondDerivativeEntries2 := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False), asecondDerivativeEntries1 := ExSecondDerivativeEntries(eLow, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));
    If (Not (tier = False), asecondDerivativeEntries2 := ExSecondDerivativeEntries(eHigh, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));

    b1 := ExPiecewiseBranch(eLow, ra, rb, gaa, gab, gbb);
    e1 := b1[1];
    aecsl1 := b1[2];
    deDra1 := b1[3];
    adeDracsl1 := b1[4];
    deDrb1 := b1[5];
    adeDrbcsl1 := b1[6];
    deGaa1 := b1[7];
    adeGaacsl1 := b1[8];
    deGab1 := b1[9];
    adeGabcsl1 := b1[10];
    deGbb1 := b1[11];
    adeGbbcsl1 := b1[12];

    b2 := ExPiecewiseBranch(eHigh, ra, rb, gaa, gab, gbb);
    e2 := b2[1];
    aecsl2 := b2[2];
    deDra2 := b2[3];
    adeDracsl2 := b2[4];
    deDrb2 := b2[5];
    adeDrbcsl2 := b2[6];
    deGaa2 := b2[7];
    adeGaacsl2 := b2[8];
    deGab2 := b2[9];
    adeGabcsl2 := b2[10];
    deGbb2 := b2[11];
    adeGbbcsl2 := b2[12];

    pwCond := cond;

    PatchLoad("excgrid_gga_piecewise_skeleton.ey");
];

// The piecewise entry point the `.ey` calls.  `args` arrives as the atom list
// in the same order ExKernelGenerate takes it, and is unpacked here rather
// than pattern-matched in the formal argument list: yacas 1.8 refuses to
// create a `:=` function whose parameter is a list pattern ("Could not create
// user function", measured), while indexing the bound list works.
ExPiecewiseKernelGenerate(fname, cond, eLow, eHigh, args) := [
    ExPiecewiseGgaGenerate(fname, cond, eLow, eHigh,
                           args[1], args[2], args[3], args[4], args[5], args[6]);
];

// --- The meta-GGA (tau-dependent) tier -------------------------------------
//
// The entry point below takes the same expression in the seven variables a
// meta-GGA reads: the five the GGA tier differentiates in, plus the two
// kinetic-energy densities the contract reserves as identifiers 5 and 6.  It
// emits the order-1 kernel and, beside it, that functional's SECOND-DERIVATIVE
// tier - the materialised upper triangle the contract's matrix view exposes,
// which is what the analytic-gradient track consumes.
//
// The second-derivative tier is generated symbolically for the same reason the
// first is: the chain rule through the reduced-gradient variables is where a
// hand-derived Hessian goes wrong, and the finite-difference gate in the tests
// is only as good as the algebra it checks.

100 # ExKernelGenerate(fname_IsString, e_IsFunction,
                     {ra_IsAtom, rb_IsAtom, gaa_IsAtom, gab_IsAtom, gbb_IsAtom,
                      ta_IsAtom, tb_IsAtom}) <--
    ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb);

// The contract's upper-triangle index: entry (i, j) with i <= j of an
// `active` by `active` matrix sits at
//     i*active - i*(i-1)/2 + (j-i),
// which is the row offset of i plus the column offset within the row.
Function("ExUpperTriangleIndex", {i, j, active})
[
    i * active - i * (i - 1) / 2 + j - i;
];

// Is the reduced expression a zero that yacas left inside a quotient?
//
// Differentiating a reciprocal whose numerator's derivative vanishes leaves
// `0/(96*(rho + Tiny)*(rho + Tiny)^(5/3)*...)` rather than folding it: zero
// everywhere the kernel is defined, but three powers and a division to compute
// it, and a declaration of the guard it divides by.  Folding it prints the same
// plain zero the printer already emits for a derivative that never had that
// variable to differentiate.
//
// The test is the NUMERATOR'S OWN TEXT: `String` is what the number printer
// emits, so a numerator that renders as the literal zero is one the emitted
// code already divides as `0.` - folding that quotient cannot move a single
// bit of the result, and the denominators here are products of positive powers
// of (rho + Tiny), so none of them is zero where the kernel is defined.
// Written this way rather than as `num = 0` because yacas' differentiation
// leaves the numerator as a residue below the working precision (measured:
// 0./(96*...) whose numerator prints as `0.` and is nevertheless not `= 0`),
// and rather than as a magnitude threshold, which would be a number this
// generator has no business inventing.
//
// The atom guard is not decoration either: Listify(0) is an error in this
// yacas, and an integer zero is exactly what the derivative of an expression
// that never carried the variable comes back as.
Function("ExIsQuotientZero", {e})
[
    Local(l, z);
    z := False;
    If (Not IsAtom(e),
    [
        l := Listify(e);
        If (ExOpIs(l, ExU/ExV),
            If (IsAtom(l[2]),
                z := ((String(l[2]) = "0.") Or (String(l[2]) = "0")),
                z := ExIsQuotientZero(l[2])));
    ]);
    z;
];

// One entry per unordered pair of the input list, in the contract's
// upper-triangle order: {row, column, flat index, expression, CSE assignments}.
// A pair the energy density does not couple comes back as the integer 0 - the
// generator must not print a different spelling of zero for it than the one
// every other kernel prints - and an uncoupled pair contributes no CSE list.
//
// The expressions are differentiated from the ORIGINAL energy density, before
// the order-1 path substitutes the CSE tags into it, because Deriv() cannot
// differentiate a tag.
//
// `radicalVars` names the reduced-gradient variables, and it is what keeps the
// entries that span one finite at an exactly zero gradient.  A reduced gradient
// enters as Sqrt(gamma), and the radical survives inside the enhancement as a
// squared occurrence - `pow(sqrt(gamma) / (2 * kF * rho), 2)` - which no factor
// cancellation can reach.  Differentiating that w.r.t. gamma leaves a quotient
// carrying Sqrt(gamma) in numerator and denominator alike, so each
// differentiation of a radical-carrying variable is followed by the same
// top-level cancellation the order-1 path applies to its own vsigma.  The
// cancellation is applied to the INNER derivative and then to the outer one
// rather than once to the finished entry, because a cancellation reaches only
// the division at the top of the tree: the outer derivative of an uncancelled
// inner quotient buries the shared radical below a sum, where the flat factor
// scan of ExCancelSharedFactors no longer sees it and the entry is NaN at
// gamma == 0.
// The mixed partials commute, so a pair spanning a radical variable and a plain
// one is differentiated w.r.t. the radical variable first; a pair spanning two
// or none is left in its own order.  A pair with no radical variable is
// differentiated exactly as it was before this argument existed, which is what
// leaves a functional without reduced gradients, and the tau tier,
// byte-identical.
//
// `tierMode` selects what happens to an entry after the top-level cancellation,
// and it exists so a repair reaches only the kernels that need it:
//   * True - no further repair.  The exchange tiers that are finite at an
//     exactly zero gradient, and every LDA and tau tier, stay byte-identical.
//   * TierGuard - every applicable radical in the entry is shifted by
//     SigmaGuard (ExGuardSigmaRadical).  The correlation forms' total-gradient
//     radical has its own edge, and the owner ruling of 2026-10-19 brought it
//     inside the guard.  becke88 and pw91 also pass this mode, but their two
//     sigma-sigma entries are hand-derived (below), so it governs only their
//     remaining entries.
//   * TierCancelSum - the numerator sum's nested quotients are cancelled
//     (ExCancelSumQuotients).  PBEsol's rational mu is the one source that
//     needs it.
// mpw91 stays on True on purpose: its tier is analytically divergent at a zero
// gradient (the x^3.72 term), so a shifted radicand would report a large finite
// number where the truth is infinite.  It is pinned in the tier test instead.
//
// A source may also supply a HAND-DERIVED expression for an individual pair,
// through the global `ahandDerivedEntries` - a list of
// {variable, variable, expression}.  A matching pair is taken verbatim: no
// differentiation, and none of the automatic repairs, because the expression
// is the derivative already.  This is what the Becke88 and PW91 sigma-sigma
// entries use: their plain second derivative cancels two terms of order
// 1/sigma, and no guard value is simultaneously representable in double and
// invisible in the answer.  The supplied expression reaches CSE and the
// printer like any other and must carry the kernel's own variable atoms; the
// list is empty unless a driver sets it.
// `For` is the C-style four-argument form here (start, predicate, increment,
// body) - yacas 1.8's controlflow.rep defines it that way, and a three-argument
// call reads its middle argument as the predicate, so it silently runs zero
// times rather than complaining.
ahandDerivedEntries := {};

Function("ExHandDerivedEntry", {first, second})
[
    Local(found);
    found := {};
    ForEach(h, ahandDerivedEntries)
        [ If (((h[1] = first) And (h[2] = second))
              Or ((h[1] = second) And (h[2] = first)),
              found := h[3]); ];
    found;
];

Function("ExSecondDerivativeEntriesLegacy", {e, vars, radicalVars, tierMode})
[
    Local(n, entries, inner, d2, reduced, i, j, swap, first, second, sv, hand);
    n := Length(vars);
    entries := {};
    For(i := 1, i <= n, i++)
    [
        For(j := i, j <= n, j++)
        [
            swap := ExHas(radicalVars, vars[j]) And Not ExHas(radicalVars, vars[i]);
            first := i;
            second := j;
            If (swap, first := j);
            If (swap, second := i);

            hand := ExHandDerivedEntry(vars[first], vars[second]);
            If (hand = {},
                [
                    inner := Deriv(vars[first]) e;
                    If (ExHas(radicalVars, vars[first]), inner := ExCancelRadical(inner));

                    // The guard belongs on the FIRST derivative, where the
                    // order-1 path already applies it, not on the raw second
                    // derivative.  The two are the same function away from the
                    // edge: d(Sqrt(u + c SigmaGuard)) carries
                    // 1/Sqrt(u + c SigmaGuard), which is exactly the shift the
                    // post-hoc walk applied to d2, but reached before the
                    // differentiation has duplicated the radical.  Guarding
                    // d2 instead made the walk recurse over pbe_correlation's
                    // (rhoA,rhoA) entry - 6447 Sqrt nodes at depth 74 - and
                    // exhausted yacas' evaluation stack.  The tier is now the
                    // derivative of the guarded first derivative, which is
                    // also what the emitted order-1 kernel actually is.
                    If (tierMode = TierGuard,
                        ForEach(sv, radicalVars)
                            [ inner := ExGuardSigmaRadical(inner, sv, ExWithout(radicalVars, sv)); ]);

                    d2 := Deriv(vars[second]) inner;
                    If (ExHas(radicalVars, vars[second]), d2 := ExCancelRadical(d2));

                    // The remaining repair, selected by the source's tier
                    // mode (the mode table and each one's measurement are
                    // beside the functions).
                    If (tierMode = TierCancelSum, d2 := ExCancelSumQuotients(d2));
                ],
                d2 := hand
            );

            If (ExIsQuotientZero(d2), d2 := 0);
            reduced := CSE(d2);
            Push(entries, {i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), reduced[1],
                           ExAssignments(reduced[2])});
        ];
    ];
    entries;
];

ExMetaGgaGenerateLegacy(fname, e, ra, rb, gaa, gab, gbb, ta, tb) := [
    // The second-derivative tier first, while `e` is still the untagged
    // expression.
    asecondDerivativeEntries :=
        ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb, ta, tb}, {}, True);

    deDra := Deriv(ra) e;
    deDrb := Deriv(rb) e;
    deGaa := Deriv(gaa) e;
    deGab := Deriv(gab) e;
    deGbb := Deriv(gbb) e;
    deDta := Deriv(ta) e;
    deDtb := Deriv(tb) e;

    // The same removable-radical cancellation the GGA path applies, for the
    // same reason and with the same measurement behind it: the chain rule
    // leaves a Sqrt(gamma) uncancelled against its own reciprocal, and the
    // emitted quotient would be 0/0 at an exactly zero gradient.  The tau
    // derivatives carry no Sqrt(gamma) and are left alone.
    deGaa := ExCancelRadical(deGaa);
    deGab := ExCancelRadical(deGab);
    deGbb := ExCancelRadical(deGbb);

    {e, ecsl} := CSE(e);

    // Express the density derivatives through the energy density's common
    // subexpressions, exactly as the GGA path does.  The kinetic-energy
    // derivatives go through the same substitution: they share the
    // reduced-variable subexpressions.
    deDra := ExSubstituteTagged(ecsl, deDra);
    deDrb := ExSubstituteTagged(ecsl, deDrb);
    deDta := ExSubstituteTagged(ecsl, deDta);
    deDtb := ExSubstituteTagged(ecsl, deDtb);

    {deDra, deDracsl} := CSE(deDra);
    {deDrb, deDrbcsl} := CSE(deDrb);
    {deGaa, deGaacsl} := CSE(deGaa);
    {deGab, deGabcsl} := CSE(deGab);
    {deGbb, deGbbcsl} := CSE(deGbb);
    {deDta, deDtacsl} := CSE(deDta);
    {deDtb, deDtbcsl} := CSE(deDtb);

    aecsl := ExAssignments(ecsl);
    adeDracsl := ExAssignments(deDracsl);
    adeDrbcsl := ExAssignments(deDrbcsl);
    adeGaacsl := ExAssignments(deGaacsl);
    adeGabcsl := ExAssignments(deGabcsl);
    adeGbbcsl := ExAssignments(deGbbcsl);
    adeDtacsl := ExAssignments(deDtacsl);
    adeDtbcsl := ExAssignments(deDtbcsl);

    PatchLoad("excgrid_meta_gga_skeleton.ey");
];

// ---------------------------------------------------------------------------
// Program-level differentiation
//
// A kernel expression is first lowered to a let-program: an ordered list of
// UniqueConstant tag assignments and one reduced expression (yacas' CSE
// returns exactly that pair).  Derivatives are then taken over the program
// rather than the expanded tree.  Each assignment's right-hand side is
// differentiated once; the chain rule travels through a tag -> derivative-tag
// map, so a shared subexpression is differentiated once and reused through its
// tag.  A tag definition is never substituted back into an expression.
//
// Cost is one pass over the program per derivative order, and recursion depth
// is the depth of one right-hand side rather than the depth of a derivative
// tree.  Differentiating an expanded tree instead copies both factors into
// both product-rule terms at every order: that is the scaling this
// representation removes (see docs/maintainer-guide.md).

// The atoms of a small expression, without numbers and without repeats.
Function("ExAtomWalk", {e, acc})
[
    If (IsAtom(e),
        If (Not (Or (IsNumber(e), Contains(acc, e))), acc := Concat(acc, {e})),
        ForEach(x, Listify(e)) [ acc := ExAtomWalk(x, acc); ]
    );
    acc;
];

// The total derivative of `e` with respect to `v`.  `dmap` maps each tag
// already differentiated to its derivative expression (the integer 0 for a
// tag whose derivative vanished).  Only tags that occur in `e` are looked up,
// so the cost is proportional to the expression, not to the program size.
// The chain-rule walk: recurse through the expression's arguments (never a
// list of atoms - yacas list storage is not stable across the internal calls
// Deriv makes), and at each distinct tag call Deriv once against the whole
// expression.  `seen` is only tested and appended, never traversed.
Function("ExTaggedDerivWalk", {node, whole, dmap, seen, d})
[
    Local(n, i, res, c, dd);
    If (IsAtom(node),
        If (Not (IsNumber(node)),
            If (Not Contains(seen, node),
                [
                    seen := Concat(seen, {node});
                    If (Association'Contains(dmap, node),
                        [
                            c := Association'Get(dmap, node);
                            If (Not (c = 0),
                                [
                                    dd := Deriv(node) whole;
                                    d := d + dd * c;
                                ]);
                        ]);
                ])),
        [
            n := NrArgs(node);
            For (i := 1, i <= n, i := i + 1)
                [
                    res := ExTaggedDerivWalk(node[i], whole, dmap, seen, d);
                    seen := res[1];
                    d := res[2];
                ];
        ]
    );
    {seen, d};
];

Function("ExTotalDeriv", {e, v, dmap})
[
    Local(res, d);
    d := Deriv(v) e;
    res := ExTaggedDerivWalk(e, e, dmap, {}, d);
    res[2];
];

// One differentiation pass over a program {reduced, assignments}.  Returns
// {derivative expression, its new assignments, the extended assignment list}.
// The extended list is what a second (or third) pass differentiates: it
// carries the original tags and the derivative tags together, which is
// exactly the input the chain rule needs.
Function("ExProgramDeriv", {prog, v})
[
    Local(reduced, csl, dmap, out, d, dt, as, dreduced);
    reduced := prog[1];
    csl := prog[2];
    dmap := Association'Create();
    out := {};
    ForEach(as, csl)
    [
        d := ExTotalDeriv(as[2], v, dmap);
        If (d = 0,
            Association'Set(dmap, as[1], 0),
            [
                dt := UniqueConstant();
                out := Concat(out, {{dt, d}});
                Association'Set(dmap, as[1], dt);
            ]
        );
    ];
    dreduced := ExTotalDeriv(reduced, v, dmap);
    {dreduced, out, Concat(csl, out), dmap};
];

// Node count of an expression, for the scaling record.
Function("ExNodeCount", {e})
[
    Local(n);
    If (IsAtom(e), 1,
        [
            n := 1;
            ForEach(x, Listify(e)) [ n := n + ExNodeCount(x); ];
            n;
        ]
    );
];

// Node count of a whole program: every assignment's right-hand side plus the
// reduced expression.
Function("ExProgramNodes", {csl, reduced})
[
    Local(n);
    n := ExNodeCount(reduced);
    ForEach(as, csl) [ n := n + ExNodeCount(as[2]); ];
    n;
];

// The assignments a reduced expression actually needs, in dependency order.
// A derivative program also carries assignments on paths the result does not
// read; evaluating those could hit an interior singularity that cancels out of
// the result, so a numeric check must not touch them.
Function("ExProgramNeeded", {csl, reduced})
[
    Local(need, out, as, a);
    need := ExAtomWalk(reduced, {});
    out := {};
    ForEach(as, Reverse(csl))
    [
        If (Contains(need, as[1]),
            [
                out := Concat(out, {as});
                ForEach(a, ExAtomWalk(as[2], {}))
                    [ If (Not Contains(need, a), need := Concat(need, {a})); ];
            ]
        );
    ];
    Reverse(out);
];

// Numeric value of a program at a point: each needed assignment is evaluated
// to a number in dependency order and the number replaces its tag, so the
// value is reached without ever expanding the symbolic program.  `vs` are the
// input atoms and `xs` the point.  Used by the generator self-checks.
Function("ExProgramValue", {csl, reduced, vs, xs})
[
    Local(tags, nums, r, v, a, dep, i);
    csl := ExProgramNeeded(csl, reduced);
    tags := {};
    nums := {};
    ForEach(a, csl)
    [
        r := a[2];
        For (i := 1, i <= Length(tags), i := i + 1)
            [ r := WithValue(tags[i], nums[i], r); ];
        r := WithValue(vs, xs, r);
        v := N(Eval(r));
        tags := Concat(tags, {a[1]});
        nums := Concat(nums, {v});
    ];
    r := reduced;
    For (i := 1, i <= Length(tags), i := i + 1)
        [ r := WithValue(tags[i], nums[i], r); ];
    r := WithValue(vs, xs, r);
    N(Eval(r));
];

// Substitute every tag of a program out, in reverse dependency order, so the
// result is an expression in the kernel's inputs.  Used by the generator
// self-checks and by numeric probes; never by kernel emission.
Function("ExProgramExpand", {csl, reduced})
[
    Local(tags, vals, r, as);
    tags := {};
    vals := {};
    ForEach(as, csl)
        [ tags := Concat(tags, {as[1]}); vals := Concat(vals, {as[2]}); ];
    r := reduced;
    // One WithValue call per dependency level, not one per tag: the tags
    // inserted by a call are themselves substituted by the next round.
    While (ExHasAnyAtom(r, tags)) [ r := WithValue(tags, vals, r); ];
    r;
];

Function("ExHasAnyAtom", {e, tags})
[
    Local(hit, x);
    If (IsAtom(e), Contains(tags, e),
        [
            hit := False;
            ForEach(x, Listify(e)) [ If (ExHasAnyAtom(x, tags), hit := True); ];
            hit;
        ]
    );
];
    r;
];

// --- Program-level generator path -------------------------------------------
//
// The order-1 outputs and the second-derivative tier are built by
// differentiating the lowered program (above), never the expanded tree.

// Is an assignment's right-hand side exactly a square root?
Function("ExIsSqrtRhs", {e})
[
    Local(l);
    If (IsAtom(e), False,
        [
            l := Listify(e);
            (Length(l) = 2) And (l[1] = Sqrt);
        ]
    );
];

// Remove radical tags from a program by substituting their right-hand sides
// back in.  A guarded radical has to be reachable by the guard's structural
// walk, so no radical may hide behind a tag; the expressions stay small
// because only radicals are inlined.
Function("ExProgramInlineRadicals", {prog})
[
    Local(rads, csl, out, as, rad, r, red);
    csl := prog[2];
    rads := {};
    ForEach(as, csl) [ If (ExIsSqrtRhs(as[2]), rads := Concat(rads, {as})); ];
    out := {};
    ForEach(as, csl)
    [
        If (Not ExIsSqrtRhs(as[2]),
            [
                r := as[2];
                ForEach(rad, Reverse(rads)) [ r := Subst(rad[1], rad[2]) r; ];
                out := Concat(out, {{as[1], r}});
            ]
        );
    ];
    red := prog[1];
    ForEach(rad, Reverse(rads)) [ red := Subst(rad[1], rad[2]) red; ];
    {red, out};
];

// One repair, selected by an atom rather than by a function argument.
Function("ExProgramRepairExpr", {e, mode, v, rest})
[
    If (mode = DensityPower, ExCancelDensityPower(e, v, rest),
    If (mode = CancelRadical, ExCancelRadical(e),
    If (mode = GuardSigma, ExGuardSigmaRadical(ExCancelRadical(e), v, rest),
    If (mode = CancelSum, ExCancelSumQuotients(e), e))));
];

// Apply a repair to every assignment and the reduced expression.
Function("ExProgramRepair", {csl, reduced, mode, v, rest})
[
    Local(out, as, red);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExProgramRepairExpr(as[2], mode, v, rest)}}); ];
    red := ExProgramRepairExpr(reduced, mode, v, rest);
    {out, red};
];

// Apply the spin-edge limit substitution to every assignment and the reduced
// expression (the LDA path's leA/leB tags).
Function("ExProgramSubstituteTagged", {csl, reduced, sl})
[
    Local(out, as);
    out := {};
    ForEach(as, csl)
        [ out := Concat(out, {{as[1], ExSubstituteTagged(sl, as[2])}}); ];
    {out, ExSubstituteTagged(sl, reduced)};
];

// The assignments of `csl` whose tag is one of the new tags in `newcsl`.
Function("ExKeepNew", {csl, newcsl})
[
    Local(out, as, nn, hit);
    out := {};
    ForEach(as, csl)
    [
        hit := False;
        ForEach(nn, newcsl) [ If (nn[1] = as[1], hit := True); ];
        If (hit, out := Concat(out, {as}));
    ];
    out;
];

// A second differentiation whose chain rule for the ORIGINAL tags is supplied
// by an existing first-derivative map (`extMap`), so the original tags are not
// differentiated again.  The assignments in `csl` are the first-derivative
// tags; a second-derivative tag is created for each one in dependency order.
Function("ExProgramDerivMapped", {csl, reduced, v, extMap})
[
    Local(dmap, out, d, dt, as, dred, p);
    dmap := Association'Create();
    ForEach(p, Association'ToList(extMap)) [ Association'Set(dmap, p[1], p[2]); ];
    out := {};
    ForEach(as, csl)
    [
        d := ExTotalDeriv(as[2], v, dmap);
        If (d = 0,
            Association'Set(dmap, as[1], 0),
            [
                dt := UniqueConstant();
                out := Concat(out, {{dt, d}});
                Association'Set(dmap, as[1], dt);
            ]
        );
    ];
    dred := ExTotalDeriv(reduced, v, dmap);
    {dred, out, Concat(csl, out), dmap};
];

// One order-1 output: differentiate the program, repair the result, prune to
// the tags the answer reads, and keep only the tags this output introduces
// (the energy tags are declared once, before every derivative block).
Function("ExFirstDerivOutput", {Pd, v, mode, gv, rest, sl})
[
    Local(r, rep, csl, kept);
    r := ExProgramDeriv(Pd, v);
    rep := ExProgramRepair(r[2], r[1], mode, gv, rest);
    csl := ExProgramNeeded(Concat(Pd[2], rep[1]), rep[2]);
    kept := ExKeepNew(csl, rep[1]);
    {rep[2], kept};
];

// The GGA straight-line kernel on the program representation.
ExGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, tier) := [
    Local(P, Pd, ecsl, eexpr, r);

    asecondDerivativeEntries := {};
    atierNeedsGuard := (tier = TierGuard);
    If (Not (tier = False),
        asecondDerivativeEntries :=
            ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb}, {gaa, gab, gbb}, tier));

    {eexpr, ecsl} := CSE(e);
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    r := ExFirstDerivOutput(Pd, ra, DensityPower, ra, {rb}, {});
    deDra := r[1]; adeDracsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, rb, DensityPower, rb, {ra}, {});
    deDrb := r[1]; adeDrbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gaa, GuardSigma, gaa, {gab, gbb}, {});
    deGaa := r[1]; adeGaacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gab, GuardSigma, gab, {gaa, gbb}, {});
    deGab := r[1]; adeGabcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gbb, GuardSigma, gbb, {gaa, gab}, {});
    deGbb := r[1]; adeGbbcsl := ExAssignments(r[2]);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    PatchLoad("excgrid_gga_skeleton.ey");
];

// The second-derivative tier on the program representation: one first-
// derivative program per variable (repaired and guarded once), then each
// entry is the mapped derivative of the row's first derivative.  Assignments
// are emitted once per C++ scope, in the first entry that needs them.
Function("ExSecondDerivativeEntries", {e, vars, radicalVars, tierMode})
[
    Local(n, entries, declared, cslP, P, Pd, RD, v, r, i, j, swap, first, second,
          hand, r1, rs, r2, rr, p1out, p1red, p2out, p2red, root, needed, newl,
          as, sv, d2, reduced);
    n := Length(vars);
    {e, cslP} := CSE(e);
    P := {e, cslP};
    Pd := ExProgramInlineRadicals(P);

    RD := Association'Create();
    ForEach(v, vars)
    [
        r := ExProgramDeriv(Pd, v);
        p1out := r[2];
        p1red := r[1];
        If (ExHas(radicalVars, v),
            [
                rr := ExProgramRepair(p1out, p1red, CancelRadical, v, {});
                p1out := rr[1]; p1red := rr[2];
            ]);
        If (tierMode = TierGuard,
            ForEach(sv, radicalVars)
            [
                rr := ExProgramRepair(p1out, p1red, GuardSigma, sv, ExWithout(radicalVars, sv));
                p1out := rr[1]; p1red := rr[2];
            ]);
        Association'Set(RD, v, {p1red, p1out, r[4]});
    ];

    entries := {};
    declared := {};
    For (i := 1, i <= n, i := i + 1)
    [
        For (j := i, j <= n, j := j + 1)
        [
            swap := ExHas(radicalVars, vars[j]) And Not ExHas(radicalVars, vars[i]);
            first := i;
            second := j;
            If (swap, first := j);
            If (swap, second := i);

            hand := ExHandDerivedEntry(vars[first], vars[second]);
            If (hand = {},
                [
                    r1 := Association'Get(RD, vars[first]);
                    rs := Association'Get(RD, vars[second]);
                    r2 := ExProgramDerivMapped(r1[2], r1[1], vars[second], rs[3]);
                    p2out := r2[2];
                    p2red := r2[1];
                    If (ExHas(radicalVars, vars[second]),
                        [
                            rr := ExProgramRepair(p2out, p2red, CancelRadical, vars[second], {});
                            p2out := rr[1]; p2red := rr[2];
                        ]);
                    If (tierMode = TierCancelSum,
                        [
                            rr := ExProgramRepair(p2out, p2red, CancelSum, 0, {});
                            p2out := rr[1]; p2red := rr[2];
                        ]);
                    root := Concat(cslP, r1[2]);
                    If (Not (vars[first] = vars[second]), root := Concat(root, rs[2]));
                    root := Concat(root, p2out);
                    needed := ExProgramNeeded(root, p2red);
                    newl := {};
                    ForEach(as, needed)
                        [ If (Not Contains(declared, as[1]),
                              [ newl := Concat(newl, {as});
                                declared := Concat(declared, {as[1]}); ]); ];
                    If (ExIsQuotientZero(p2red), p2red := 0);
                    entries := Concat(entries,
                        {{i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), p2red,
                          ExAssignments(newl)}});
                ],
                [
                    d2 := hand;
                    If (ExIsQuotientZero(d2), d2 := 0);
                    reduced := CSE(d2);
                    entries := Concat(entries,
                        {{i - 1, j - 1, ExUpperTriangleIndex(i - 1, j - 1, n), reduced[1],
                          ExAssignments(reduced[2])}});
                ]
            );
        ];
    ];
    entries;
];

// A program's assignments without the tags of another program (the LDA
// skeleton declares its limit tags in the block itself).
Function("ExWithoutTags", {csl, excl})
[
    Local(out, as, ex, hit);
    out := {};
    ForEach(as, csl)
    [
        hit := False;
        ForEach(ex, excl) [ If (ex[1] = as[1], hit := True); ];
        If (Not hit, out := Concat(out, {as}));
    ];
    out;
];

// The LDA straight-line kernel: the two density derivatives, each expressed
// through the opposite spin's exact zero-limit program.  The skeleton's
// derivative blocks are their own C++ scopes, so the block carries the energy
// tags it reads; the limit tags are emitted by the skeleton itself.
ExLdaGenerate(fname, e, ra, rb, tier) := [
    Local(P, Pd, ecsl, eexpr, leA, leB, leAcsl, leBcsl, r, rep, sub, all, kept);

    asecondDerivativeEntries := {};
    atierNeedsGuard := False;
    If (Not (tier = False),
        asecondDerivativeEntries := ExSecondDerivativeEntries(e, {ra, rb}, {}, tier));

    {eexpr, ecsl} := CSE(e);
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    leA := WithValue(ra, 0, e);
    If (leA = Undefined, leA := Limit(ra, 0, Right) e);
    leB := WithValue(rb, 0, e);
    If (leB = Undefined, leB := Limit(rb, 0, Right) e);
    {leA, leAcsl} := CSE(leA);
    {leB, leBcsl} := CSE(leB);

    r := ExProgramDeriv(Pd, ra);
    rep := ExProgramRepair(r[2], r[1], DensityPower, ra, {rb});
    sub := ExProgramSubstituteTagged(rep[1], rep[2], leBcsl);
    all := ExProgramNeeded(Concat(Pd[2], leBcsl, sub[1]), sub[2]);
    kept := ExWithoutTags(all, leBcsl);
    deDra := sub[2];
    adeDracsl := ExAssignments(kept);

    r := ExProgramDeriv(Pd, rb);
    rep := ExProgramRepair(r[2], r[1], DensityPower, rb, {ra});
    sub := ExProgramSubstituteTagged(rep[1], rep[2], leAcsl);
    all := ExProgramNeeded(Concat(Pd[2], leAcsl, sub[1]), sub[2]);
    kept := ExWithoutTags(all, leAcsl);
    deDrb := sub[2];
    adeDrbcsl := ExAssignments(kept);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    aleAcsl := ExAssignments(leAcsl);
    aleBcsl := ExAssignments(leBcsl);
    PatchLoad("excgrid_lda_skeleton.ey");
];

// The meta-GGA straight-line kernel on the program representation.
ExMetaGgaGenerate(fname, e, ra, rb, gaa, gab, gbb, ta, tb) := [
    Local(P, Pd, ecsl, eexpr, r);

    asecondDerivativeEntries :=
        ExSecondDerivativeEntries(e, {ra, rb, gaa, gab, gbb, ta, tb}, {}, True);

    {eexpr, ecsl} := CSE(e);
    P := {eexpr, ecsl};
    Pd := ExProgramInlineRadicals(P);

    r := ExFirstDerivOutput(Pd, ra, DensityPower, ra, {rb}, {});
    deDra := r[1]; adeDracsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, rb, DensityPower, rb, {ra}, {});
    deDrb := r[1]; adeDrbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gaa, CancelRadical, gaa, {}, {});
    deGaa := r[1]; adeGaacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gab, CancelRadical, gab, {}, {});
    deGab := r[1]; adeGabcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, gbb, CancelRadical, gbb, {}, {});
    deGbb := r[1]; adeGbbcsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, ta, None, ta, {}, {});
    deDta := r[1]; adeDtacsl := ExAssignments(r[2]);
    r := ExFirstDerivOutput(Pd, tb, None, tb, {}, {});
    deDtb := r[1]; adeDtbcsl := ExAssignments(r[2]);

    e := eexpr;
    aecsl := ExAssignments(ecsl);
    PatchLoad("excgrid_meta_gga_skeleton.ey");
];
