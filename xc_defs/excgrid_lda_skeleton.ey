// The excgrid LDA kernel skeleton (fresh authorship; BSD-3-Clause).
// Emits one excgrid::XcKernelValue function per LDA functional: the energy
// density and its spin-density derivatives, with the exact one-spin-zero
// limit branches (the generator's limit substitution supplies the limit
// expressions).
<?  // Appended to the banner only when the source asks for a tier, so a
    // functional shipping order 1 alone carries no claim that it has one.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries))) [
        WriteString("// It also emits the functional's SECOND-DERIVATIVE tier: one function filling" : Nl());
        WriteString("// the contract's materialised matrix, from the same expression as the kernel." : Nl());
        WriteString("// The matrix is the contract's upper triangle, row-major over the two" : Nl());
        WriteString("// densities in identifier order, which is the LDA tier's whole span - an LDA" : Nl());
        WriteString("// energy density reads no other component, so the gradient and" : Nl());
        WriteString("// kinetic-energy-density rows and columns are not emitted at all rather than" : Nl());
        WriteString("// emitted as zeros.  The tier is taken from the guarded expression, not from" : Nl());
        WriteString("// the limit branches above: the Tiny guards already keep it finite at the spin" : Nl());
        WriteString("// edges, which is what makes it a straight-line form where the order-1 kernel" : Nl());
        WriteString("// is not." : Nl());
    ]; ?>// The banner and the kernel.hpp include are emitted by the calling .ey, which
// always precedes this skeleton, so they are not repeated here.

#include <cmath>
#include <limits>

namespace excgrid {

XcKernelValue <? WriteString(fname); ?>(double rhoA, double rhoB)
{
    constexpr double eps = std::numeric_limits<double>::epsilon();
    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;

    XcKernelValue result;

    if (rhoA + rhoB < 2. * eps)
    {
        return result;
    }

    if (rhoA >= eps && rhoB >= eps)
    {
<?  ForEach(d, Reverse(aecsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.exc = <? WriteString(ExCppForm(e)); ?>;
    }
    else if (rhoA < eps)
    {
<?  ForEach(d, Reverse(aleAcsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.exc = <? WriteString(ExCppForm(leA)); ?>;
    }
    else
    {
<?  ForEach(d, Reverse(aleBcsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.exc = <? WriteString(ExCppForm(leB)); ?>;
    }

    if (rhoA >= eps)
    {
<?  ForEach(d, Reverse(aleBcsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ];
    ForEach(d, Reverse(adeDracsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoA = <? WriteString(ExCppForm(deDra)); ?>;
    }

    if (rhoB >= eps)
    {
<?  ForEach(d, Reverse(aleAcsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ];
    ForEach(d, Reverse(adeDrbcsl)) [ WriteString("        const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
        result.vrhoB = <? WriteString(ExCppForm(deDrb)); ?>;
    }

    return result;
}

<?  // Written from inside a guard rather than as literal text because a
    // functional whose second differentiation the codegen gate cannot afford
    // emits order 1 alone: it gets no tier function at all rather than one
    // that would answer zeros.  clang-format normalises what is written here,
    // so only the token sequence has to be right.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries))) [
        WriteString("void " : fname : "SecondDerivatives(double rhoA, double rhoB," : Nl());
        WriteString("                                              PointSecondDerivativeMatrix& matrix)" : Nl());
        WriteString("{" : Nl());
        WriteString("    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;" : Nl());
        WriteString(Nl());
        WriteString("    if (rhoA + rhoB < 2. * std::numeric_limits<double>::epsilon())" : Nl());
        WriteString("    {" : Nl());
        WriteString("        return;" : Nl());
        WriteString("    }" : Nl());
        WriteString(Nl());
        ForEach(entry, asecondDerivativeEntries) [
            ForEach(d, Reverse(entry[5])) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ];
            WriteString("    matrix.upper[" : String(entry[3]) : "] = " : ExCppForm(entry[4]) : ";" : Nl());
            WriteString(Nl());
        ];
        WriteString("}" : Nl());
        WriteString(Nl());
    ]; ?>
} // namespace excgrid
