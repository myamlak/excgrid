// excgrid codegen source: the Perdew 1986 GGA correlation functional, the gradient
// correction on the Perdew-Zunger LDA piece: J. P. Perdew, Phys. Rev. B 33, 8822 (1986).

// <? WriteString("Auto-generated file, do not modify"); ?>
#include "excgrid/kernel.hpp"

<?
    Builtin'Precision'Set(16);

    Use("excgrid_defs.ys");
    Use("excgrid_generate.ys");

    // The PZ81 LDA piece is piecewise at rs = 1 (Perdew & Zunger, Phys. Rev. B 23,
    // 5048 (1981)); this is the tree's only branch-carrying kernel.
    cond := X'Rs(rhoA + rhoB) >= 1.;
    eLow := X'P86CorrelationLow(rhoA, rhoB, sigmaAa, sigmaAb, sigmaBb);
    eHigh := X'P86CorrelationHigh(rhoA, rhoB, sigmaAa, sigmaAb, sigmaBb);

    // TierGuard: both branches carry the total-gradient radical, guarded in order 1
    // and in the tier so each answers the finite limit at zero gradient.
    ExPiecewiseKernelGenerate("P86Correlation", cond, eLow, eHigh,
                              {rhoA, rhoB, sigmaAa, sigmaAb, sigmaBb, TierGuard});
?>
