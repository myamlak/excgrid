// The excgrid GGA kernel skeleton (fresh authorship; BSD-3-Clause).
// Emits one excgrid::XcKernelValue function per GGA functional: the energy
// density, the spin-density derivatives, and the three sigma derivatives.
<?  // Appended to the banner only when the source asks for a tier, so a
    // functional shipping order 1 alone carries no claim that it has one.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries))) [
        WriteString("// It also emits the functional's SECOND-DERIVATIVE tier: one function filling" : Nl());
        WriteString("// the contract's materialised matrix, from the same expression as the kernel." : Nl());
        WriteString("// The matrix is the contract's upper triangle, row-major over the five" : Nl());
        WriteString("// components the kernel takes, in identifier order - the GGA tier's whole" : Nl());
        WriteString("// span.  Which of them a caller's matrix is over is the caller's mask, and the" : Nl());
        WriteString("// registry re-packs the two; the kinetic-energy-density rows and columns are" : Nl());
        WriteString("// not emitted at all, because a GGA energy density does not read tau." : Nl());
    ]; ?>// No spin-edge branches: the definitions' Tiny guards keep every expression
// finite at the spin and gamma edges (the LDA skeleton's exact-limit
// machinery is not needed for the gradient-corrected forms, whose edge
// contributions vanish with the spin density).
// The banner and the kernel.hpp include are emitted by the calling .ey, which
// always precedes this skeleton, so they are not repeated here.

#include <cmath>
#include <limits>

namespace excgrid {

XcKernelValue <? WriteString(fname); ?>(double rhoA,
                                       double rhoB,
                                       double sigmaAa,
                                       double sigmaAb,
                                       double sigmaBb)
{
<? WriteString(ExUnusedParamSilence({{ra, "rhoA"}, {rb, "rhoB"}, {gaa, "sigmaAa"}, {gab, "sigmaAb"}, {gbb, "sigmaBb"}},
                                    {e, deDra, deDrb, deGaa, deGab, deGbb},
                                    {aecsl, adeDracsl, adeDrbcsl, adeGaacsl, adeGabcsl, adeGbbcsl})); ?>
    constexpr double eps = std::numeric_limits<double>::epsilon();
    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;
    // The sigma-edge guard the generator adds to a vanishing channel radical
    // (ExGuardSigmaRadical in excgrid_generate.ys carries the measurement).
    // Its value has to be written HERE rather than injected from the
    // definitions: the printer renders a number below 1e-16 as "0.", so a
    // constant small enough to be absorbed by every normal sigma cannot reach
    // the expression through yacas at all.  1e-300 is absorbed by every sigma
    // above ~1e-284 and leaves the sum at exactly sigma, which is what keeps
    // the guarded arithmetic bit-identical to the unguarded one.
    [[maybe_unused]] constexpr double SigmaGuard = 1e-300;

    XcKernelValue result;

    if (rhoA + rhoB < 2. * eps)
    {
        return result;
    }

<?  ForEach(d, Reverse(aecsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.exc = <? WriteString(ExCppForm(e)); ?>;

<?  ForEach(d, Reverse(adeDracsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.vrhoA = <? WriteString(ExCppForm(deDra)); ?>;

<?  ForEach(d, Reverse(adeDrbcsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.vrhoB = <? WriteString(ExCppForm(deDrb)); ?>;

<?  ForEach(d, Reverse(adeGaacsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.vsigmaAa = <? WriteString(ExCppForm(deGaa)); ?>;

<?  ForEach(d, Reverse(adeGabcsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.vsigmaAb = <? WriteString(ExCppForm(deGab)); ?>;

<?  ForEach(d, Reverse(adeGbbcsl)) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ]; ?>
    result.vsigmaBb = <? WriteString(ExCppForm(deGbb)); ?>;

    return result;
}

<?  // Written from inside a guard rather than as literal text because a
    // functional whose second differentiation the codegen gate cannot afford
    // emits order 1 alone: it gets no tier function at all rather than one
    // that would answer zeros.  clang-format normalises what is written here,
    // so only the token sequence has to be right.
    ForEach(emit, ExTierEmissionGuard(Length(asecondDerivativeEntries))) [
        WriteString("void " : fname : "SecondDerivatives(double rhoA," : Nl());
        WriteString("                                              double rhoB," : Nl());
        WriteString("                                              double sigmaAa," : Nl());
        WriteString("                                              double sigmaAb," : Nl());
        WriteString("                                              double sigmaBb," : Nl());
        WriteString("                                              PointSecondDerivativeMatrix& matrix)" : Nl());
        WriteString("{" : Nl());
        WriteString(ExUnusedParamSilence({{ra, "rhoA"}, {rb, "rhoB"}, {gaa, "sigmaAa"}, {gab, "sigmaAb"}, {gbb, "sigmaBb"}},
                                          {e, deDra, deDrb, deGaa, deGab, deGbb},
                                          {aecsl, adeDracsl, adeDrbcsl, adeGaacsl, adeGabcsl, adeGbbcsl}));
        WriteString(Nl());
        WriteString("    [[maybe_unused]] constexpr double Pi = 3.14159265358979323846;" : Nl());
        WriteString(Nl());
        WriteString("    if (rhoA + rhoB < 2. * std::numeric_limits<double>::epsilon())" : Nl());
        WriteString("    {" : Nl());
        WriteString("        return;" : Nl());
        WriteString("    }" : Nl());
        WriteString(Nl());
        ForEach(entry, asecondDerivativeEntries) [
            ForEach(d, Reverse(entry[5])) [ WriteString("    const double " : ExCppForm(d) : ";" : Nl()); ];
            WriteString("    matrix.upper[" : String(entry[3]) : "] = " : ExCppForm(entry[4]) : ";" : Nl());
            WriteString(Nl());
        ];
        WriteString("}" : Nl());
        WriteString(Nl());
    ]; ?>
} // namespace excgrid
