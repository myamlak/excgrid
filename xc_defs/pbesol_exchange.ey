// with the other functional citations in docs/mainpage.md.  Regenerate
// with tools/regenerate.py.

// <? WriteString("Auto-generated file, do not modify"); ?>
#include "excgrid/kernel.hpp"

<?
    Builtin'Precision'Set(16);

    Use("excgrid_defs.ys");
    Use("excgrid_generate.ys");

    e := X'PbeSolExchange(rhoA, rhoB, sigmaAa, sigmaAb, sigmaBb);

    // The enhancement's mu crosses as the division 10/81 rather than as a
    // single decimal, and the second differentiation of that shape leaves the
    // shared Sqrt(sigma) in a nested quotient inside the outer derivative's
    // numerator SUM, where the top-level cancellation cannot reach it.  The
    // kernel is finite at a zero gradient, so the tier must be too.  The owner
    // ruling of 2026-10-19 funded the sum-level cancellation rewrite:
    // TierCancelSum cancels at the divisions the numerator sum carries, and
    // leaves the order-1 kernel untouched.  The same form with mu as a decimal
    // is one quotient and cancels at the top, which is why the three other
    // PBE-shaped exchanges need no mode.
    ExKernelGenerate("PbeSolExchange", e, rhoA, rhoB, sigmaAa, sigmaAb, sigmaBb, TierCancelSum);
?>
